abel=\"Send me a starting plan\">\n      <p>We'd set up a small Google Ads campaign for searches like &ldquo;{{keyword_1}}&rdquo; around {{town}}, and tell you plainly what it costs to run. Pick a monthly ad budget you'd be comfortable testing, and you'll get a starting plan with a fixed price for the setup.</p>\n      <input type=\"hidden\" name=\"id\" value=\"{{lead_id}}\">\n      <input type=\"hidden\" name=\"t\" value=\"{{token}}\">\n      <input type=\"hidden\" name=\"offer\" value=\"starting_plan\">\n      <div class=\"pair\">\n        <label for=\"s-budget\">Monthly ad budget\n          <select id=\"s-budget\" name=\"budget\">\n            <option value=\"not sure\">Not sure yet</option>\n            <option value=\"under 1000\">Under $1,000</option>\n            <option value=\"1000-2000\">$1,000 to $2,000</option>\n            <option value=\"2000-4000\">$2,000 to $4,000</option>\n            <option value=\"4000+\">$4,000 or more</option>\n          </select></label>\n      </div>\n      <label for=\"s-notes\"><span>Anything we should know? <span class=\"opt\">(optional)</span></span>\n        <textarea id=\"s-notes\" name=\"notes\" placeholder=\"For example: we want more furnace replacements, not service calls.\"></textarea></label>\n      <p class=\"err\" role=\"alert\" hidden></p>\n      <div class=\"row\"><button class=\"btn\" type=\"submit\">Send me a starting plan</button></div>\n    </form>\n    <div id=\"ask-setup-done\" hidden>\n      <p><strong>Got it.</strong> Your starting plan will be in your inbox by the end of the next business day.</p>\n    </div>\n  </div>\n\n  <div class=\"ask\" id=\"ask-general\" {{ask_general_hidden}}>\n    <h2>Want a hand with any of this?</h2>\n    <form class=\"ask-form\" method=\"post\" action=\"/api/quote-request\" data-done=\"ask-general-done\" data-label=\"Send me the details\">\n      <p>Tell us where you are with Google Ads and you'll get a straight answer on what we'd do first and what it costs.</p>\n      <input type=\"hidden\" name=\"id\" value=\"{{lead_id}}\">\n      <input type=\"hidden\" name=\"t\" value=\"{{token}}\">\n      <input type=\"hidden\" name=\"offer\" value=\"details\">\n      <div class=\"pair\">\n        <label for=\"g-ads\">Running Google Ads now?\n          <select id=\"g-ads\" name=\"running_ads\">\n            <option value=\"not sure\">Not sure</option>\n            <option value=\"yes\">Yes</option>\n            <option value=\"no\">No</option>\n          </select></label>\n        <label for=\"g-budget\">Monthly ad budget\n          <select id=\"g-budget\" name=\"budget\">\n            <option value=\"not sure\">Not sure yet</option>\n            <option value=\"under 1000\">Under $1,000</option>\n            <option value=\"1000-2000\">$1,000 to $2,000</option>\n            <option value=\"2000-4000\">$2,000 to $4,000</option>\n            <option value=\"4000+\">$4,000 or more</option>\n          </select></label>\n      </div>\n      <label for=\"g-notes\"><span>Anything we should know? <span class=\"opt\">(optional)</span></span>\n        <textarea id=\"g-notes\" name=\"notes\" placeholder=\"For example: we tried ads a few years ago and stopped.\"></textarea></label>\n      <p class=\"err\" role=\"alert\" hidden></p>\n      <div class=\"row\"><button class=\"btn\" type=\"submit\">Send me the details</button></div>\n    </form>\n    <div id=\"ask-general-done\" hidden>\n      <p><strong>Got it.</strong> You'll hear back by the end of the next business day.</p>\n    </div>\n  </div>\n\n  <section aria-labelledby=\"sources-title\">\n    <h2 id=\"sources-title\">What we looked at</h2>\n    <ul class=\"sources\">\n{{{sources}}}\n    </ul>\n    <p class=\"fine method\" {{method_hidden}}>{{method_note}}</p>\n  </section>\n</main>\n<footer class=\"wrap foot\">\n  <p>Prepared by {{sender_name}}, Ledge Communications, Alberta, Canada.</p>\n  <p>This audit uses public information only. Nobody called your business, clicked your ads, or filled in your forms.</p>\n</footer>\n<script>\n(function () {\n  [].forEach.call(document.querySelectorAll('.ask-form'), function (form) {\n    form.addEventListener('submit', function (e) {\n      e.preventDefault();\n      var btn = form.querySelector('button'), err = form.querySelector('.err');\n      btn.disabled = true; btn.textContent = 'Sending…'; err.hidden = true;\n      fetch('/api/quote-request', { method: 'POST', body: new FormData(form), headers: { 'accept': 'application/json' } })\n        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.ok) throw new Error(); }); })\n        .then(function () { form.hidden = true; document.getElementById(form.getAttribute('data-done')).hidden = false; })\n        .catch(function () {\n          btn.disabled = false; btn.textContent = form.getAttribute('data-label');\n          err.textContent = \"That didn't go through. Reply to the email with \\\"yes\\\" and we'll take it from there.\";\n          err.hidden = false;\n        });\n    });\n  });\n})();\n</script>\n</body>\n</html>\n";

var PROPOSAL_TEMPLATE = "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<title>{{doc_label}}: {{business}}</title>\n<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,900&family=Inter+Tight:wght@700;800&family=Inter:wght@400;500;600;700&display=swap\">\n<style>\n/* Ledge theme: the one place colour and type are set, shared by the site, audit pages, and proposal pages.\n   Current picks: round 3 Amber 2 (royal blue and orange, a quiet vintage Oilers nod), on warm paper with deep navy\n   header and bands; type C (Inter Tight + Inter). Light only: no automatic dark version.\n   --accent is the orange used for buttons; --deep is royal blue for kickers and links; --spruce is the dark bands. */\n:root {\n  --snow: #F8F6F2;\n  --surface: #EFEAE2;\n  --ink: #0F1A2E;\n  --muted: #4D5870;\n  --rule: #E0D9CE;\n  --sky: #2A4FA0;\n  --deep: #2A4FA0;\n  --deep-ink: #FFFFFF;\n  --accent: #F08A24;\n  --accent-ink: #0F1A2E;\n  --accent-text: #A04F0A;\n  --ice: #DDE4F2;\n  --spruce: #0C1630;\n  --head-bg: #0C1630;\n  --head-ink: #FFFFFF;\n  --head-muted: #B9C3D8;\n  --on-dark: #FFFFFF;\n  --on-dark-muted: #B9C3D8;\n  --scrim: rgb(12 22 48 / 0.62);\n  --bad: #B23A26;\n  --good: #2D7A4F;\n  --leak: #A84B0C;\n  --unknown: #5F6B75;\n  --display: \"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif;\n  --display-weight: 800;\n  --display-track: -0.02em;\n  --h3-weight: 700;\n  --body-size: 17px;\n  --body: \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  --mark: \"Archivo\", \"Helvetica Neue\", Arial, sans-serif;\n  color-scheme: light;\n}\n/* Shared layout for audit and proposal pages. Colour and type come from theme.css. */\n*, *::before, *::after { box-sizing: border-box; }\n[hidden] { display: none !important; }\nbody { margin: 0; background: var(--snow); color: var(--ink); font: var(--body-size)/1.6 var(--body); -webkit-font-smoothing: antialiased; }\na { color: inherit; text-underline-offset: 3px; }\nh1, h2, h3 { font-family: var(--display); font-weight: var(--display-weight); margin: 0; line-height: 1.08; text-wrap: balance; letter-spacing: calc(var(--display-track) * 0.8); }\nh3 { font-weight: var(--h3-weight); letter-spacing: -0.01em; }\np { margin: 0; }\n:focus-visible { outline: 3px solid var(--sky); outline-offset: 3px; border-radius: 2px; }\n.wrap { max-width: 820px; margin-inline: auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }\n.top { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 18px; }\n.wm { display: inline-grid; text-decoration: none; line-height: 1; color: var(--ink); }\n.wm-top { font-family: var(--mark); font-weight: 900; font-stretch: 125%; font-size: 1.45rem; letter-spacing: 0.03em; }\n.wm-sub { font-family: var(--body); font-weight: 600; font-size: 0.52rem; letter-spacing: 0.37em; margin-top: 0.35em; color: var(--muted); }\n.doc-label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }\n.strip { height: clamp(120px, 22vw, 200px); background: var(--spruce) center 62% / cover no-repeat; border-radius: 6px; }\n.hero { display: grid; gap: 12px; padding-block: 32px 12px; }\n.label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }\nh1 { font-size: clamp(2.2rem, 6.4vw, 3.2rem); }\n.meta { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.9rem; color: var(--muted); }\n.lede { font-size: 1.12rem; max-width: 40rem; margin-top: 4px; }\nsection { padding-block: 26px; }\nh2 { font-size: 1.7rem; margin-bottom: 14px; }\n.btn { display: inline-flex; align-items: center; justify-content: center; font: 600 1.02rem/1.2 var(--body); text-decoration: none; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 6px; padding: 0.85em 1.3em; cursor: pointer; }\n.btn[disabled] { opacity: 0.6; cursor: progress; }\n.fine { font-size: 0.86rem; color: var(--muted); }\n.foot { padding-block: 24px 40px; border-top: 1px solid var(--rule); font-size: 0.86rem; color: var(--muted); display: grid; gap: 6px; }\n\n/* Layout: a one-page offer. What we'll do, what you get, what's not included, timing, the price (with the fee table\n   for monthly work), one button. */\n.strip { background-image: url(\"/assets/tower-1200.jpg\"); background-position: 70% 100%; }\n.plain { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }\n.plain li { padding-block: 13px; border-bottom: 1px solid var(--rule); display: grid; gap: 2px; }\n.plain b { font-weight: 600; }\n.plain span { color: var(--muted); font-size: 0.96rem; }\n.ticks { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; }\n.price { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: clamp(20px, 4vw, 30px); display: grid; gap: 16px; }\n.price-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; padding-bottom: 14px; border-bottom: 1px solid var(--rule); }\n.price-row b { font-weight: 600; font-size: 1.05rem; }\n.price-row .amt { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.7rem; font-variant-numeric: tabular-nums; }\n.price-row .amt small { font-family: var(--body); font-weight: 500; font-size: 0.85rem; color: var(--muted); }\n.price-row.quiet .amt { font-size: 1.3rem; color: var(--muted); }\n.price-row.credit .amt { font-size: 1.3rem; color: var(--good); }\n.price-row p { flex-basis: 100%; color: var(--muted); font-size: 0.95rem; }\n.tiers { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 0.97rem; }\n.tiers caption { text-align: left; font-weight: 600; padding-bottom: 8px; }\n.tiers th, .tiers td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--rule); }\n.tiers th { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }\n.tiers td:last-child, .tiers th:last-child { text-align: right; }\n.tiers tr.yours td { background: var(--ice); font-weight: 600; }\n.tiers-note { color: var(--muted); font-size: 0.92rem; margin-top: 8px; }\n.approve { display: grid; gap: 10px; justify-items: start; }\n.approve form { display: grid; gap: 14px; justify-items: start; }\n.addons { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; min-width: 0; }\n.addons legend { font-weight: 600; padding: 0; margin-bottom: 4px; }\n.addons legend span { font-weight: 400; color: var(--muted); }\n.addons label { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px; align-items: start; background: var(--snow); border: 1.5px solid var(--rule); border-radius: 6px; padding: 12px 14px; cursor: pointer; color: var(--muted); font-size: 0.95rem; }\n.addons label b { color: var(--ink); font-weight: 600; display: block; }\n.addons input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--deep); }\n.addons label:has(input:checked) { border-color: var(--deep); }\n.approved { border-left: 4px solid var(--good); padding: 10px 16px; background: var(--snow); border-radius: 4px; }\n.err { color: var(--leak); font-weight: 500; }\n.plain-list { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; color: var(--muted); }\n.plain-list + .fine { margin-top: 12px; }\n</style>\n</head>\n<body>\n<header class=\"wrap top\">\n  <a class=\"wm\" href=\"/\" aria-label=\"Ledge Communications\"><span class=\"wm-top\" aria-hidden=\"true\">LEDGE</span><span class=\"wm-sub\" aria-hidden=\"true\">COMMUNICATIONS</span></a>\n  <span class=\"doc-label\">{{doc_label}}</span>\n</header>\n<main class=\"wrap\">\n  <div class=\"strip\" role=\"img\" aria-label=\"Looking up at a glass tower against a blue sky\"></div>\n  <div class=\"hero\">\n    <p class=\"label\">Prepared for</p>\n    <h1>{{business}}</h1>\n    <p class=\"meta\"><span>Prepared {{date}}</span><span>Price good until {{valid_until}}</span></p>\n    <p class=\"lede\">{{lede}}</p>\n  </div>\n\n  <section aria-labelledby=\"what-title\">\n    <h2 id=\"what-title\">{{scope_title}}</h2>\n    <ol class=\"plain\">\n{{{scope}}}\n    </ol>\n  </section>\n\n  <section aria-labelledby=\"inc-title\">\n    <h2 id=\"inc-title\">What you get</h2>\n    <ul class=\"ticks\">\n{{{included}}}\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"out-title\">\n    <h2 id=\"out-title\">Not included</h2>\n    <ul class=\"plain-list\">\n{{{excluded}}}\n    </ul>\n    <p class=\"fine\">If something turns out bigger once we're in, you'll hear about it before any extra work, and you can say no.</p>\n  </section>\n\n  <section aria-labelledby=\"time-title\">\n    <h2 id=\"time-title\">Timing and what we need from you</h2>\n    <ul class=\"ticks\">\n{{{timing}}}\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"price-title\">\n    <h2 id=\"price-title\">Price</h2>\n    <div class=\"price\">\n{{{price_rows}}}\n      <div {{tiers_hidden}}>\n        <table class=\"tiers\">\n          <caption>How the monthly fee is set</caption>\n          <thead><tr><th scope=\"col\">Your monthly ad budget</th><th scope=\"col\">Our monthly fee</th></tr></thead>\n          <tbody>\n{{{tiers}}}\n          </tbody>\n        </table>\n        <p class=\"tiers-note\">{{tiers_note}}</p>\n      </div>\n      <div class=\"approve\" id=\"approve-box\" {{approve_hidden}}>\n        <form id=\"approve-form\" method=\"post\" action=\"/api/approve\">\n          <input type=\"hidden\" name=\"id\" value=\"{{lead_id}}\">\n          <input type=\"hidden\" name=\"t\" value=\"{{token}}\">\n{{{addons}}}\n          <button class=\"btn\" id=\"a-btn\" type=\"submit\">{{approve_label}}</button>\n        </form>\n        <p class=\"fine\">{{payment_line}}</p>\n        <p class=\"err\" id=\"a-err\" role=\"alert\" hidden></p>\n      </div>\n      <div class=\"approved\" id=\"approved-box\" {{approved_hidden}}><p><strong>Approved{{approved_on}}.</strong> Thanks. Next steps are on their way to your inbox.</p></div>\n    </div>\n  </section>\n\n  <section>\n    <p>Questions, or want to change the budget or the scope? Just reply to the email.</p>\n  </section>\n</main>\n<footer class=\"wrap foot\">\n  <p>{{sender_name}}, Ledge Communications, Alberta, Canada.</p>\n</footer>\n<script>\n(function () {\n  var form = document.getElementById('approve-form');\n  if (!form) return;\n  var label = document.getElementById('a-btn').textContent;\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    var btn = document.getElementById('a-btn'), err = document.getElementById('a-err');\n    btn.disabled = true; btn.textContent = 'Approving…'; err.hidden = true;\n    fetch('/api/approve', { method: 'POST', body: new FormData(form), headers: { 'accept': 'application/json' } })\n      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.ok) throw new Error(); }); })\n      .then(function () { document.getElementById('approve-box').hidden = true; document.getElementById('approved-box').hidden = false; })\n      .catch(function () {\n        btn.disabled = false; btn.textContent = label;\n        err.textContent = \"That didn't go through. Reply to the email with \\\"approved\\\" and we'll take it from there.\";\n        err.hidden = false;\n      });\n  });\n})();\n</script>\n</body>\n</html>\n";

var PROMPT_AUDIT = "You build Local Search Audits for Ledge Communications, a small Alberta business run by Logan. Ledge helps local service businesses get found and chosen on Google: Google Ads, Google Guaranteed (Local Services Ads), the Google Business Profile that drives the map, and the page an ad click lands on. Most clients are owner-run trades shops (heating and cooling, plumbing, electrical, roofing, garage doors, appliance repair), but the same work fits any local business people search for on their phone.\n\nAn audit is a one-page look at one business from the outside. The owner reads it on their phone. It has to be accurate, specific, and worth reading even if they never hire Ledge. It should also make plain, without selling, what it would take to show up where their customers are looking.\n\n# What you're given\nThe request ends with EVIDENCE gathered by our tools today:\n- Two Google searches a customer would run, done as a phone located in the shop's town. For each: the Google Guaranteed box, the sponsored results, the map pack, and the websites, top of the page down, with the shop marked [THIS SHOP] wherever it showed up. Plus where the shop sits in Google Maps for the same search.\n- Google's monthly search estimates for those searches and two related ones, with the total. The total is the better number for the size of the opportunity (\"about 520 searches a month in Airdrie across searches like these\"). A single small figure for a \"near me\" search undersells it.\n- The shop's Google Search ads in Google's Ads Transparency Center over the last 30 days. This sets the segment: `running_ads`, `no_ads`, or `unknown`.\n- A scan of the home page code: Google Ads tag, Google Analytics, Tag Manager, call tracking, tap-to-call links, forms, and online booking.\n- The shop's Google rating and review count, when we found its profile in Maps.\n\nThe audit page shows the searches itself, as a table, so don't restate every row. Use them for findings.\n\n# Rules that never bend\n- Public information only. You read pages; you never contact the business, click an ad, submit a form, or pretend to be a customer.\n- Every finding is something in the evidence or something you saw yourself on a page you fetched or a search result you read today. Link pages you used in `sources`.\n- No invented numbers. Use only counts, ranks, ratings, and search estimates from the evidence or a page you read. Round search estimates the way they're given (\"about 170 searches a month\").\n- Never guess what a shop spends on ads, what a click or a lead costs, or what they \"lose\". Don't quote click prices from the evidence. No industry statistics or percentages.\n- A search is a snapshot. Say \"when we searched\" or \"on this search\", never \"you never show up\".\n- A shop missing from one search's ads isn't proof it doesn't advertise. The Transparency Center record decides that.\n- No Google Ads tag on the home page doesn't mean there's no tracking when Google Tag Manager is installed. Say it may be inside Tag Manager and mark that check `unknown`.\n- Only suggest Google Guaranteed when a Google Guaranteed box showed on at least one of the searches.\n- If the evidence is mostly missing (the searches didn't run) and you can't find at least three real findings yourself, set `\"build\": false` and give the reason. A thin audit does more harm than none.\n\n# How to research (a few fetches, at most a couple of searches)\n1. Fetch the home page and the contact page. Look at what a phone visitor sees first: the phone number, tap-to-call, a form, online booking, and what the page says the business does.\n2. If the evidence has no rating for the shop, search once for its Google reviews.\n3. Fetch other pages only when a finding depends on it (for example a service page for the main search).\n\n# The six checks, always in this order\n1. Map results: where the shop sits on the map and in Google Maps for each search, and the most likely reason when it's low (category, few reviews, a different town in the profile). Only name a reason you can see.\n2. Google Guaranteed: who is in the box and whether the shop is.\n3. Search ads: what the Transparency Center shows for the shop, whether its ads appeared on the searches, and who advertises on them.\n4. Reviews: rating, count, and how they compare with the shops above them on the map, using the evidence numbers.\n5. Call and form tracking: what the home page scan shows (Google Ads tag, Analytics, Tag Manager, call tracking). For a shop not running ads, say what would need to be in place before ad money is spent.\n6. Where clicks land: what a phone visitor sees on the page ads and searches lead to: tap-to-call near the top, a short form, online booking, emergency or after-hours service if the business offers it.\n\nEach check gets `status` (`good`, `gap`, or `unknown`; `gap` shows on the page as \"Needs work\") and a `note`: one or two short sentences naming the actual search, rank, number, or button.\n\n# The three moves\nThree moves, ranked by what would most likely bring the shop more calls and booked jobs from Google right now, given the season. Each has an `offer`, which shows on the page as a small tag:\n- `setup`: Ledge sets up Google Ads, Google Guaranteed, or call tracking for a shop that isn't running ads. Use only when the segment is `no_ads` or `unknown`.\n- `paid_audit`: the paid Google Ads account audit, where Ledge looks inside the account. Use only when the segment is `running_ads` or `unknown`.\n- `management`: Ledge runs and improves ads month to month. Use only when the segment is `running_ads` or `unknown`.\n- `page_fixes`: a one-time add-on where Ledge changes their current website so more clicks turn into calls: a tap-to-call button near the top, a shorter form, a booking button, call tracking. Any segment. Their web person could do it too, and the tag on the page says so.\n- `landing_page`: a one-time add-on where Ledge builds one page for their ads, when the site has no page about the service they'd advertise, or it's too slow or broken to send ad clicks to. Use it rarely; prefer `page_fixes`.\n- `free`: something the owner can do themselves in a few minutes, like a Google Business Profile change. At most one free move, and it goes last unless it's clearly the most urgent (for example the site is down or has no phone number).\n\nAt most one page move (`page_fixes` or `landing_page`) per audit. A page move is the right call when \"Where clicks land\" needs work, because ads or Google Guaranteed would send people there.\n\nFor a `running_ads` shop the first move is usually `paid_audit`: name the specific thing from the evidence that the account audit would explain (ads missing from their main search, no call tracking, clicks landing on a page with no tap-to-call). For a `no_ads` shop the first move is usually `setup`: point at who is advertising or in Google Guaranteed on their searches, and Google's search estimate.\n\n- `title`: an instruction, under 12 words.\n- `why`: one or two sentences tied to the evidence.\n- `effort`: only for a `free` move, in plain words (for example \"About five minutes in your Google Business Profile\"). Leave it empty for the others; the page shows their price.\n\nAnything worth fixing that isn't one of these moves (a slow or broken website, a site rebuild, a missing service page, social media) goes in `later` as one plain sentence, at most two items, or leave `later` empty. Never price or promise those.\n\n# What the owner told us\nIf the request includes what the owner said on the form, use it. It can settle a check you couldn't see from outside; say \"You told us...\" in that note. Never let it override something you saw yourself.\n\n# Voice\nLedge should read as reliable, honest, knowledgeable, and human. Never salesy, pushy, jargony, or trendy.\n- Write the way Logan would explain it across a counter: plain words, short sentences, friendly, straight to the point.\n- Say \"you\" and \"your shop\" (or \"your clinic\", \"your business\", whatever fits). Name the real search, rank, page, or number.\n- Say \"Google Guaranteed\", \"the ads\", \"the map\", \"Google Maps\". Avoid jargon like CPC, CTR, ROAS, SERP, LSA, conversion rate, funnel, or impressions.\n- No hype words (game-changer, seamless, unlock, leverage, robust, streamline, supercharge, elevate, dominate).\n- No em dashes. No \"not X, but Y\". No rhetorical questions. No exclamation marks.\n- Use the Oxford comma in any list of three or more (\"calls, forms, and quotes\").\n- Don't use the words \"leak\", \"leaky\", or \"slip\". Say plainly what's missing, slow, or hard to find.\n- Give credit where it's due. If something is good, say so.\n- `summary`: two sentences at most. The first says what a customer sees when they search; the second names the biggest opportunity.\n- `top_finding`: one sentence, under 25 words, the biggest finding in plain words. It goes into an email.\n- `fix_1`: the first move as a lowercase phrase that completes \"I'd start here: ...\".\n\n# Contact details (only when the request says Purpose: cold)\nLedge may email this business, so Canada's anti-spam law applies. Find an email address the business itself published on its own website or its own Google listing.\n- Never guess an address and never take one from a directory, data broker, or third-party listing site.\n- If the page near the address says it doesn't want solicitations or marketing email, set `no_solicitation_notice` to true.\n- `proof_url` is the page where you saw the address and `proof_excerpt` is about 100 characters of the text around it, copied exactly.\n- Use the owner's first name only if the site names them. Otherwise leave it empty.\n- If there is no qualifying address, set `email` to null. The audit can still be built.\n\n# Output\nReply with one JSON object inside a single ```json code block and nothing after it:\n\n```json\n{\n  \"build\": true,\n  \"skip_reason\": \"\",\n  \"business\": \"Business name as the business writes it\",\n  \"area\": \"Airdrie\",\n  \"summary\": \"...\",\n  \"checks\": [\n    {\"status\": \"gap\", \"note\": \"...\"},\n    {\"status\": \"gap\", \"note\": \"...\"},\n    {\"status\": \"gap\", \"note\": \"...\"},\n    {\"status\": \"good\", \"note\": \"...\"},\n    {\"status\": \"unknown\", \"note\": \"...\"},\n    {\"status\": \"gap\", \"note\": \"...\"}\n  ],\n  \"moves\": [\n    {\"title\": \"...\", \"why\": \"...\", \"offer\": \"setup\", \"effort\": \"\"},\n    {\"title\": \"...\", \"why\": \"...\", \"offer\": \"setup\", \"effort\": \"\"},\n    {\"title\": \"...\", \"why\": \"...\", \"offer\": \"free\", \"effort\": \"...\"}\n  ],\n  \"later\": [\"...\"],\n  \"sources\": [\n    {\"label\": \"Home page\", \"url\": \"https://...\"},\n    {\"label\": \"Contact page\", \"url\": \"https://...\"}\n  ],\n  \"top_finding\": \"...\",\n  \"fix_1\": \"...\",\n  \"contact\": {\n    \"email\": null,\n    \"first_name\": \"\",\n    \"contact_name\": \"\",\n    \"phone\": \"\",\n    \"proof_url\": \"\",\n    \"proof_excerpt\": \"\",\n    \"no_solicitation_notice\": false\n  }\n}\n```\n";

var PROMPT_FIND = "You find prospects for Ledge Communications, a small Alberta business that helps owner-run local service businesses get found and chosen on Google: Google Ads, Google Guaranteed, and the map.\n\nFind owner-run shops in the area and trades the request names.\n\nInclude a shop only if:\n- It has its own website (not just a directory listing or a social page).\n- It looks independently owned. Skip franchises, national chains, and big multi-city companies.\n- It actually serves the area named.\n- Its website domain is not in the exclusion list.\n\nPrefer established shops with roughly 10 to 300 reviews: both shops that already show up in the sponsored results and shops that don't advertise at all.\n\nUse a few searches. You don't need to fetch every site; the audit step does the deep look later.\n\nReply with one JSON object inside a single ```json code block and nothing after it:\n\n```json\n{\n  \"shops\": [\n    {\"business\": \"Shop name\", \"website\": \"https://example.ca\", \"area\": \"Calgary NE\", \"trade\": \"Heating and cooling\", \"note\": \"Why it fits, in a few words\"}\n  ]\n}\n```\n";
