var AUDIT_TEMPLATE = "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<title>Local Search Audit: {{business}}</title>\n<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,900&family=Inter+Tight:wght@700;800&family=Inter:wght@400;500;600;700&display=swap\">\n<style>\n/* Ledge theme: the one place colour and type are set, shared by the site, audit pages, and proposal pages.\n   Current picks: round 3 Amber 2 (royal blue and orange, a quiet vintage Oilers nod), on warm paper with deep navy\n   header and bands; type C (Inter Tight + Inter). Light only: no automatic dark version.\n   --accent is the orange used for buttons; --deep is royal blue for kickers and links; --spruce is the dark bands. */\n:root {\n  --snow: #F8F6F2;\n  --surface: #EFEAE2;\n  --ink: #0F1A2E;\n  --muted: #4D5870;\n  --rule: #E0D9CE;\n  --sky: #2A4FA0;\n  --deep: #2A4FA0;\n  --deep-ink: #FFFFFF;\n  --accent: #F08A24;\n  --accent-ink: #0F1A2E;\n  --accent-text: #A04F0A;\n  --ice: #DDE4F2;\n  --spruce: #0C1630;\n  --head-bg: #0C1630;\n  --head-ink: #FFFFFF;\n  --head-muted: #B9C3D8;\n  --on-dark: #FFFFFF;\n  --on-dark-muted: #B9C3D8;\n  --scrim: rgb(12 22 48 / 0.62);\n  --bad: #B23A26;\n  --good: #2D7A4F;\n  --leak: #A84B0C;\n  --unknown: #5F6B75;\n  --display: \"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif;\n  --display-weight: 800;\n  --display-track: -0.02em;\n  --h3-weight: 700;\n  --body-size: 17px;\n  --body: \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  --mark: \"Archivo\", \"Helvetica Neue\", Arial, sans-serif;\n  color-scheme: light;\n}\n/* Shared layout for audit and proposal pages. Colour and type come from theme.css. */\n*, *::before, *::after { box-sizing: border-box; }\n[hidden] { display: none !important; }\nbody { margin: 0; background: var(--snow); color: var(--ink); font: var(--body-size)/1.6 var(--body); -webkit-font-smoothing: antialiased; }\na { color: inherit; text-underline-offset: 3px; }\nh1, h2, h3 { font-family: var(--display); font-weight: var(--display-weight); margin: 0; line-height: 1.08; text-wrap: balance; letter-spacing: calc(var(--display-track) * 0.8); }\nh3 { font-weight: var(--h3-weight); letter-spacing: -0.01em; }\np { margin: 0; }\n:focus-visible { outline: 3px solid var(--sky); outline-offset: 3px; border-radius: 2px; }\n.wrap { max-width: 820px; margin-inline: auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }\n.top { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 18px; }\n.wm { display: inline-grid; text-decoration: none; line-height: 1; color: var(--ink); }\n.wm-top { font-family: var(--mark); font-weight: 900; font-stretch: 125%; font-size: 1.45rem; letter-spacing: 0.03em; }\n.wm-sub { font-family: var(--body); font-weight: 600; font-size: 0.52rem; letter-spacing: 0.37em; margin-top: 0.35em; color: var(--muted); }\n.doc-label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }\n.strip { height: clamp(120px, 22vw, 200px); background: var(--spruce) center 62% / cover no-repeat; border-radius: 6px; }\n.hero { display: grid; gap: 12px; padding-block: 32px 12px; }\n.label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }\nh1 { font-size: clamp(2.2rem, 6.4vw, 3.2rem); }\n.meta { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.9rem; color: var(--muted); }\n.lede { font-size: 1.12rem; max-width: 40rem; margin-top: 4px; }\nsection { padding-block: 26px; }\nh2 { font-size: 1.7rem; margin-bottom: 14px; }\n.btn { display: inline-flex; align-items: center; justify-content: center; font: 600 1.02rem/1.2 var(--body); text-decoration: none; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 6px; padding: 0.85em 1.3em; cursor: pointer; }\n.btn[disabled] { opacity: 0.6; cursor: progress; }\n.fine { font-size: 0.86rem; color: var(--muted); }\n.foot { padding-block: 24px 40px; border-top: 1px solid var(--rule); font-size: 0.86rem; color: var(--muted); display: grid; gap: 6px; }\n\n/* Layout: a one-page report read on a phone. Photo strip and the shop's name, then the searches as a customer saw them\n   (the evidence, top of the page to the bottom), six checks, three moves, and one ask that fits where the shop is with ads. */\n.strip { background-image: url(\"/assets/elevators-1200.jpg\"); background-position: center 64%; }\n.intro { color: var(--muted); max-width: 40rem; margin-bottom: 16px; }\n\n.searches { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }\n.search { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: 16px clamp(14px, 3vw, 22px) 14px; display: grid; gap: 12px; min-width: 0; }\n.q { display: grid; gap: 4px; }\n.q-text { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.3rem; line-height: 1.2; letter-spacing: -0.01em; overflow-wrap: anywhere; }\n.q-meta { display: flex; flex-wrap: wrap; gap: 2px 14px; font-size: 0.88rem; color: var(--muted); }\n.serp { margin: 0; display: grid; border-top: 2px solid var(--ink); }\n.slot { display: grid; grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr); gap: 4px 14px; padding-block: 10px; border-bottom: 1px solid var(--rule); align-items: baseline; }\n.slot dt { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }\n.slot dd { margin: 0; min-width: 0; }\n.slot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }\n.biz { display: flex; align-items: baseline; gap: 8px; font-size: 0.97rem; line-height: 1.4; min-width: 0; }\n.biz .r { flex: 0 0 1.3em; color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.85rem; }\n.biz .b { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 8px; min-width: 0; }\n.biz .n { font-weight: 600; overflow-wrap: anywhere; min-width: 0; }\n.biz .m { color: var(--muted); font-size: 0.88rem; }\n.biz.you { background: var(--ice); margin-inline: -8px; padding: 3px 8px; border-radius: 4px; }\n.biz .tag { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; background: var(--deep); color: var(--deep-ink); border-radius: 99px; padding: 1px 8px; }\n.slot .none, .slot .more { color: var(--muted); font-size: 0.92rem; }\n.slot .more { display: block; margin-top: 2px; padding-left: calc(1.3em + 8px); }\n.you-line { font-size: 0.97rem; font-weight: 500; }\n.estimates { margin-top: 14px; color: var(--muted); font-size: 0.95rem; max-width: 46rem; }\n@media (max-width: 560px) { .slot { grid-template-columns: minmax(0, 1fr); } }\n\n.checks { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }\n.checks li { display: grid; grid-template-columns: minmax(0, 11rem) auto minmax(0, 1fr); gap: 6px 16px; align-items: baseline; padding-block: 14px; border-bottom: 1px solid var(--rule); }\n.checks b { font-weight: 600; }\n.pill { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border: 1.5px solid currentColor; border-radius: 99px; padding: 1px 9px; white-space: nowrap; justify-self: start; }\n.pill.good { color: var(--good); } .pill.gap, .pill.leak { color: var(--leak); } .pill.unknown { color: var(--unknown); }\n.checks .note { color: var(--muted); font-size: 0.97rem; line-height: 1.5; min-width: 0; }\n@media (max-width: 640px) { .checks li { grid-template-columns: minmax(0, 1fr) auto; } .checks .note { grid-column: 1 / -1; } }\n\n.moves { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; counter-reset: move; }\n.moves li { background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 18px 20px; display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 4px 12px; counter-increment: move; }\n.moves li::before { content: counter(move); font-family: var(--display); font-weight: var(--display-weight); font-size: 1.6rem; line-height: 1; color: var(--accent-text); grid-row: span 4; }\n.moves h3 { font-family: var(--body); font-weight: 600; font-size: 1.08rem; line-height: 1.35; }\n.moves p { color: var(--muted); font-size: 0.97rem; }\n.moves .effort { color: var(--ink); font-size: 0.9rem; }\n.moves .offer { justify-self: start; margin-top: 4px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--deep); }\n.moves .offer.free { color: var(--good); }\n.later { margin-top: 18px; padding: 16px 20px; border-left: 3px solid var(--rule); display: grid; gap: 6px; }\n.later h3 { font-family: var(--body); font-weight: 600; font-size: 1rem; }\n.later ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 4px; color: var(--muted); font-size: 0.95rem; }\n\n.ask { background: var(--spruce); color: var(--on-dark); border-radius: 8px; padding: clamp(22px, 4vw, 34px); display: grid; gap: 14px; margin-block: 18px; }\n.ask h2 { margin: 0; }\n.ask p { max-width: 36rem; }\n.ask .price { font-weight: 600; }\n.ask .price small { font-weight: 400; color: var(--on-dark-muted); font-size: 0.95rem; }\n.ask label { font-size: 0.9rem; font-weight: 600; display: grid; gap: 6px; }\n.ask label .opt { font-weight: 400; opacity: 0.8; }\n.ask textarea, .ask select { width: 100%; font: inherit; font-size: 1rem; font-weight: 400; color: var(--ink); background: var(--surface); border: 1.5px solid var(--rule); border-radius: 6px; padding: 0.6em 0.7em; }\n.ask textarea { min-height: 84px; resize: vertical; }\n.ask .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; max-width: 36rem; }\n@media (max-width: 560px) { .ask .pair { grid-template-columns: minmax(0, 1fr); } }\n.ask-form { display: grid; gap: 14px; }\n.ask .row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }\n.ask .btn { background: var(--accent); color: var(--accent-ink); }\n.ask .err { color: #FFB4A6; font-weight: 500; }\n\n.value { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: clamp(18px, 3.5vw, 28px); display: grid; gap: 10px; margin-top: 8px; }\n.value .label { margin: 0; }\n.value-big { font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(1.9rem, 6vw, 2.6rem); line-height: 1.05; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }\n.value-big small { font-family: var(--body); font-weight: 500; font-size: 0.95rem; color: var(--muted); letter-spacing: 0; }\n.value p { max-width: 40rem; }\n.value .fine { max-width: 44rem; }\n\n.pick { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; max-width: 36rem; min-width: 0; }\n.pick legend { font-size: 0.9rem; font-weight: 600; padding: 0; margin-bottom: 4px; }\n.pick label { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px; align-items: start; font-weight: 400; background: rgba(255, 255, 255, 0.06);\n  border: 1.5px solid rgba(255, 255, 255, 0.18); border-radius: 6px; padding: 12px 14px; cursor: pointer; }\n.pick label:has(input:checked) { border-color: var(--accent); background: rgba(255, 255, 255, 0.1); }\n.pick input { margin-top: 0.3em; accent-color: var(--accent); }\n.pick b { display: block; font-weight: 600; }\n.pick .tag { display: inline-block; margin-left: 6px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; background: var(--accent);\n  color: var(--accent-ink); border-radius: 99px; padding: 1px 8px; vertical-align: 2px; }\n.pick span span { color: var(--on-dark-muted); font-size: 0.93rem; }\n\n.sources { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; color: var(--muted); font-size: 0.95rem; }\n.sources a { color: var(--ink); overflow-wrap: anywhere; }\n.method { margin-top: 12px; }\n</style>\n</head>\n<body>\n<header class=\"wrap top\">\n  <a class=\"wm\" href=\"/\" aria-label=\"Ledge Communications\"><span class=\"wm-top\" aria-hidden=\"true\">LEDGE</span><span class=\"wm-sub\" aria-hidden=\"true\">COMMUNICATIONS</span></a>\n  <span class=\"doc-label\">Local Search Audit</span>\n</header>\n<main class=\"wrap\">\n  <div class=\"strip\" role=\"img\" aria-label=\"Old Alberta Wheat Pool grain elevators in winter\"></div>\n  <div class=\"hero\">\n    <p class=\"label\">Prepared for</p>\n    <h1>{{business}}</h1>\n    <p class=\"meta\"><span>{{area}}</span><span>Checked {{date}}</span><span>Public information only</span></p>\n    <p class=\"lede\">{{summary}}</p>\n    <div class=\"value\" {{value_hidden}}>\n      <p class=\"label\">What these searches are worth</p>\n      <p class=\"value-big\" {{value_headline_hidden}}>{{value_headline}} <small>in work, roughly*</small></p>\n      <p>{{value_line}} {{value_big}}</p>\n      <p class=\"fine\">* {{value_footnote}}</p>\n    </div>\n  </div>\n\n  <section aria-labelledby=\"searches-title\" {{searches_hidden}}>\n    <h2 id=\"searches-title\">What a customer sees</h2>\n    <p class=\"intro\">We searched the way your customers do, on a phone in {{town}}. Here's what came up, from the top of the page down.</p>\n    <ol class=\"searches\">\n{{{searches}}}\n    </ol>\n    <p class=\"estimates\" {{estimates_hidden}}>{{estimates_line}}</p>\n  </section>\n\n  <section aria-labelledby=\"checks-title\">\n    <h2 id=\"checks-title\">{{checks_title}}</h2>\n    <ol class=\"checks\">\n{{{checks}}}\n    </ol>\n  </section>\n\n  <section aria-labelledby=\"moves-title\">\n    <h2 id=\"moves-title\">{{moves_title}}</h2>\n    <ol class=\"moves\">\n{{{moves}}}\n    </ol>\n    <div class=\"later\" {{later_hidden}}>\n      <h3>Also worth a look</h3>\n      <ul>\n{{{later}}}\n      </ul>\n    </div>\n  </section>\n\n  <div class=\"ask\" id=\"ask-audit\" {{ask_audit_hidden}}>\n    <h2>Want a look inside your ad account?</h2>\n    <form class=\"ask-form\" method=\"post\" action=\"/api/quote-request\" data-done=\"ask-audit-done\" data-label=\"Book the audit\">\n      <p>From the outside we can see where you show up. Inside your Google Ads account we can see why: which searches you're paying for, what each call costs you, and where the budget goes. You'd link your account to our Google Ads manager account. We only look, nothing changes without your OK, and you can remove our access at any time. <a href=\"/report/sample/\" target=\"_blank\" rel=\"noopener\">See a sample report</a>.</p>\n      <fieldset class=\"pick\" {{pick_hidden}}>\n        <legend>Pick one</legend>\n        <label for=\"a-pick-1\"><input type=\"radio\" id=\"a-pick-1\" name=\"addons\" value=\"\"> <span><b>Google Ads audit, ${{price_audit}}{{gst_note}}</b><span>Where your ad budget goes and what to change first.</span></span></label>\n        <label for=\"a-pick-2\"><input type=\"radio\" id=\"a-pick-2\" name=\"addons\" value=\"site_audit\" checked> <span><b>Google Ads and site audit, ${{price_full}}{{gst_note}} <span class=\"tag\">Suggested</span></b><span>The same, plus your website checked the way a customer on a phone sees it, with each fix priced. Your audit found things to fix on both.</span></span></label>\n      </fieldset>\n      <p class=\"price\"><span {{single_price_hidden}}>${{price_audit}}{{gst_note}} for the Google Ads audit. </span><small {{credit_hidden}}>{{credit_line}}</small></p>\n      <input type=\"hidden\" name=\"id\" value=\"{{lead_id}}\">\n      <input type=\"hidden\" name=\"t\" value=\"{{token}}\">\n      <input type=\"hidden\" name=\"offer\" value=\"account_audit\">\n      <label for=\"a-notes\"><span>Anything we should know? <span class=\"opt\">(optional)</span></span>\n        <textarea id=\"a-notes\" name=\"notes\" placeholder=\"For example: we spend about $1,500 a month and most calls come from Airdrie.\"></textarea></label>\n      <p class=\"err\" role=\"alert\" hidden></p>\n      <div class=\"row\"><button class=\"btn\" type=\"submit\">Book the audit</button></div>\n    </form>\n    <div id=\"ask-audit-done\" hidden>\n      <p><strong>Got it.</strong> You'll have the next steps, including how to link your account, by the end of the next business day.</p>\n    </div>\n  </div>\n\n  <div class=\"ask\" id=\"ask-setup\" {{ask_setup_hidden}}>\n    <h2>Want to show up in these searches?</h2>\n    <form class=\"ask-form\" method=\"post\" action=\"/api/quote-request\" data-done=\"ask-setup-done\" data-label=\"Send me a starting plan\">\n      <p>We'd set up a small Google Ads campaign for searches like &ldquo;{{keyword_1}}&rdquo; around {{town}}, and tell you plainly what it costs to run. Pick a monthly ad budget you'd be comfortable testing, and you'll get a starting plan with a fixed price for the setup.</p>\n      <input type=\"hidden\" name=\"id\" value=\"{{lead_id}}\">\n      <input type=\"hidden\" name=\"t\" value=\"{{token}}\">\n      <input type=\"hidden\" name=\"offer\" value=\"starting_plan\">\n      <div class=\"pair\">\n        <label for=\"s-budget\">Monthly ad budget\n          <select id=\"s-budget\" name=\"budget\">\n            <option value=\"not sure\">Not sure yet</option>\n            <option value=\"under 1000\">Under $1,000</option>\n            <option value=\"1000-2000\">$1,000 to $2,000</option>\n            <option value=\"2000-4000\">$2,000 to $4,000</option>\n            <option value=\"4000+\">$4,000 or more</option>\n          </select></label>\n      </div>\n      <label for=\"s-notes\"><span>Anything we should know? <span class=\"opt\">(optional)</span></span>\n        <textarea id=\"s-notes\" name=\"notes\" placeholder=\"For example: we want more furnace replacements, not service calls.\"></textarea></label>\n      <p class=\"err\" role=\"alert\" hidden></p>\n      <div class=\"row\"><button class=\"btn\" type=\"submit\">Send me a starting plan</button></div>\n    </form>\n    <div id=\"ask-setup-done\" hidden>\n      <p><strong>Got it.</strong> Your starting plan will be in your inbox by the end of the next business day.</p>\n    </div>\n  </div>\n\n  <div class=\"ask\" id=\"ask-general\" {{ask_general_hidden}}>\n    <h2>Want a hand with any of this?</h2>\n    <form class=\"ask-form\" method=\"post\" action=\"/api/quote-request\" data-done=\"ask-general-done\" data-label=\"Send me the details\">\n      <p>Tell us where you are with Google Ads and you'll get a straight answer on what we'd do first and what it costs.</p>\n      <input type=\"hidden\" name=\"id\" value=\"{{lead_id}}\">\n      <input type=\"hidden\" name=\"t\" value=\"{{token}}\">\n      <input type=\"hidden\" name=\"offer\" value=\"details\">\n      <div class=\"pair\">\n        <label for=\"g-ads\">Running Google Ads now?\n          <select id=\"g-ads\" name=\"running_ads\">\n            <option value=\"not sure\">Not sure</option>\n            <option value=\"yes\">Yes</option>\n            <option value=\"no\">No</option>\n          </select></label>\n        <label for=\"g-budget\">Monthly ad budget\n          <select id=\"g-budget\" name=\"budget\">\n            <option value=\"not sure\">Not sure yet</option>\n            <option value=\"under 1000\">Under $1,000</option>\n            <option value=\"1000-2000\">$1,000 to $2,000</option>\n            <option value=\"2000-4000\">$2,000 to $4,000</option>\n            <option value=\"4000+\">$4,000 or more</option>\n          </select></label>\n      </div>\n      <label for=\"g-notes\"><span>Anything we should know? <span class=\"opt\">(optional)</span></span>\n        <textarea id=\"g-notes\" name=\"notes\" placeholder=\"For example: we tried ads a few years ago and stopped.\"></textarea></label>\n      <p class=\"err\" role=\"alert\" hidden></p>\n      <div class=\"row\"><button class=\"btn\" type=\"submit\">Send me the details</button></div>\n    </form>\n    <div id=\"ask-general-done\" hidden>\n      <p><strong>Got it.</strong> You'll hear back by the end of the next business day.</p>\n    </div>\n  </div>\n\n  <section aria-labelledby=\"sources-title\">\n    <h2 id=\"sources-title\">What we looked at</h2>\n    <ul class=\"sources\">\n{{{sources}}}\n    </ul>\n    <p class=\"fine method\" {{method_hidden}}>{{method_note}}</p>\n  </section>\n</main>\n<footer class=\"wrap foot\">\n  <p>Prepared by {{sender_name}}, Ledge Communications, Alberta, Canada.</p>\n  <p>This audit uses public information only. Nobody called your business, clicked your ads, or filled in your forms.</p>\n</footer>\n<script>\n(function () {\n  [].forEach.call(document.querySelectorAll('.ask-form'), function (form) {\n    form.addEventListener('submit', function (e) {\n      e.preventDefault();\n      var btn = form.querySelector('button'), err = form.querySelector('.err');\n      btn.disabled = true; btn.textContent = 'Sending…'; err.hidden = true;\n      fetch('/api/quote-request', { method: 'POST', body: new FormData(form), headers: { 'accept': 'application/json' } })\n        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.ok) throw new Error(); }); })\n        .then(function () { form.hidden = true; document.getElementById(form.getAttribute('data-done')).hidden = false; })\n        .catch(function () {\n          btn.disabled = false; btn.textContent = form.getAttribute('data-label');\n          err.textContent = \"That didn't go through. Reply to the email with \\\"yes\\\" and we'll take it from there.\";\n          err.hidden = false;\n        });\n    });\n  });\n  // Tells the hub the audit was read: once per visit, after four seconds on screen.\n  var id = document.querySelector('.ask-form input[name=\"id\"]'), tk = document.querySelector('.ask-form input[name=\"t\"]');\n  if (!id || !tk || !id.value || id.value === 'sample' || !navigator.sendBeacon) return;\n  var sent = false, timer = null;\n  function arm() {\n    clearTimeout(timer);\n    if (sent || document.visibilityState !== 'visible') return;\n    timer = setTimeout(function () {\n      if (sent || document.visibilityState !== 'visible') return;\n      sent = true;\n      var d = new FormData(); d.append('id', id.value); d.append('t', tk.value);\n      navigator.sendBeacon('/api/viewed', d);\n    }, 4000);\n  }\n  document.addEventListener('visibilitychange', arm);\n  arm();\n})();\n</script>\n</body>\n</html>\n";

var PROPOSAL_TEMPLATE = "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<title>{{doc_label}}: {{business}}</title>\n<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,900&family=Inter+Tight:wght@700;800&family=Inter:wght@400;500;600;700&display=swap\">\n<style>\n/* Ledge theme: the one place colour and type are set, shared by the site, audit pages, and proposal pages.\n   Current picks: round 3 Amber 2 (royal blue and orange, a quiet vintage Oilers nod), on warm paper with deep navy\n   header and bands; type C (Inter Tight + Inter). Light only: no automatic dark version.\n   --accent is the orange used for buttons; --deep is royal blue for kickers and links; --spruce is the dark bands. */\n:root {\n  --snow: #F8F6F2;\n  --surface: #EFEAE2;\n  --ink: #0F1A2E;\n  --muted: #4D5870;\n  --rule: #E0D9CE;\n  --sky: #2A4FA0;\n  --deep: #2A4FA0;\n  --deep-ink: #FFFFFF;\n  --accent: #F08A24;\n  --accent-ink: #0F1A2E;\n  --accent-text: #A04F0A;\n  --ice: #DDE4F2;\n  --spruce: #0C1630;\n  --head-bg: #0C1630;\n  --head-ink: #FFFFFF;\n  --head-muted: #B9C3D8;\n  --on-dark: #FFFFFF;\n  --on-dark-muted: #B9C3D8;\n  --scrim: rgb(12 22 48 / 0.62);\n  --bad: #B23A26;\n  --good: #2D7A4F;\n  --leak: #A84B0C;\n  --unknown: #5F6B75;\n  --display: \"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif;\n  --display-weight: 800;\n  --display-track: -0.02em;\n  --h3-weight: 700;\n  --body-size: 17px;\n  --body: \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  --mark: \"Archivo\", \"Helvetica Neue\", Arial, sans-serif;\n  color-scheme: light;\n}\n/* S