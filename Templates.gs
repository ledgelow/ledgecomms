on { padding-block: 26px; }\nh2 { font-size: 1.7rem; margin-bottom: 14px; }\n.btn { display: inline-flex; align-items: center; justify-content: center; font: 600 1.02rem/1.2 var(--body); text-decoration: none; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 6px; padding: 0.85em 1.3em; cursor: pointer; }\n.btn[disabled] { opacity: 0.6; cursor: progress; }\n.fine { font-size: 0.86rem; color: var(--muted); }\n.foot { padding-block: 24px 40px; border-top: 1px solid var(--rule); font-size: 0.86rem; color: var(--muted); display: grid; gap: 6px; }\n\n/* Layout: the paid account audit, read on a phone. The numbers first, then the searches that cost money and brought\n   nothing, seven checks, the campaigns, what to change (each with who'd do it), the first month, and the plan link. */\n.strip { background-image: url(\"/assets/sunset-1200.jpg\"); background-position: 50% 62%; }\n\n.tiles { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }\n@media (max-width: 720px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } .tile:first-child { grid-column: 1 / -1; } }\n.tile { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: 14px 16px; display: grid; gap: 2px; align-content: start; min-width: 0; }\n.tile-label { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }\n.tile-value { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.6rem; line-height: 1.15; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }\n.tile-note { font-size: 0.84rem; color: var(--muted); }\n.fine.under { margin-top: 10px; }\n\n.intro { color: var(--muted); max-width: 40rem; margin-bottom: 14px; }\n.table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }\n.data { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 0.95rem; }\n.data th, .data td { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--rule); vertical-align: baseline; }\n.data thead th { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); border-bottom: 2px solid var(--ink); white-space: nowrap; }\n.data td + td, .data th + th { text-align: right; white-space: nowrap; }\n.data td:first-child { overflow-wrap: anywhere; min-width: 9rem; }\n.data small { display: block; color: var(--muted); font-size: 0.82rem; }\n.data th, .data td { padding-inline: 8px; }\n@media (max-width: 560px) { .campaigns .clicks, .campaigns .conv { display: none; } .data td:first-child { min-width: 6.5rem; } .data { font-size: 0.9rem; } .data thead th { letter-spacing: 0.03em; } }\n\n.checks { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }\n.checks li { display: grid; grid-template-columns: minmax(0, 11rem) auto minmax(0, 1fr); gap: 6px 16px; align-items: baseline; padding-block: 14px; border-bottom: 1px solid var(--rule); }\n.checks b { font-weight: 600; }\n.pill { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border: 1.5px solid currentColor; border-radius: 99px; padding: 1px 9px; white-space: nowrap; justify-self: start; }\n.pill.good { color: var(--good); } .pill.gap { color: var(--leak); } .pill.unknown { color: var(--unknown); }\n.checks .note { color: var(--muted); font-size: 0.97rem; line-height: 1.5; min-width: 0; }\n@media (max-width: 640px) { .checks li { grid-template-columns: minmax(0, 1fr) auto; } .checks .note { grid-column: 1 / -1; } }\n\n.moves { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; counter-reset: move; }\n.moves li { background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 18px 20px; display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 4px 12px; counter-increment: move; }\n.moves li::before { content: counter(move); font-family: var(--display); font-weight: var(--display-weight); font-size: 1.6rem; line-height: 1; color: var(--accent-text); grid-row: span 3; }\n.moves h3 { font-family: var(--body); font-weight: 600; font-size: 1.08rem; line-height: 1.35; }\n.moves p { color: var(--muted); font-size: 0.97rem; }\n.moves .offer { justify-self: start; margin-top: 4px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--deep); display: flex; flex-wrap: wrap; gap: 2px 12px; }\n.moves .offer.free { color: var(--good); }\n.moves .when { color: var(--muted); font-weight: 600; }\n\n.month { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; max-width: 40rem; }\n\n.ask { background: var(--spruce); color: var(--on-dark); border-radius: 8px; padding: clamp(22px, 4vw, 34px); display: grid; gap: 14px; margin-block: 18px; justify-items: start; }\n.ask h2 { margin: 0; }\n.ask p { max-width: 36rem; }\n.ask .btn { background: var(--accent); color: var(--accent-ink); }\n.method { max-width: 40rem; }\n\n.value { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: clamp(18px, 3.5vw, 28px); display: grid; gap: 10px; margin-bottom: 14px; }\n.value .label { margin: 0; }\n.value-big { font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(1.9rem, 6vw, 2.6rem); line-height: 1.05; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }\n.value-big small { font-family: var(--body); font-weight: 500; font-size: 0.95rem; color: var(--muted); letter-spacing: 0; }\n.value p { max-width: 42rem; }\n\n.site-intro { color: var(--muted); max-width: 42rem; margin-bottom: 14px; }\n.speed { list-style: none; margin: 0 0 18px; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 10px; }\n.speed li { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: 12px 14px; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: center; }\n.speed .score { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.5rem; width: 2.6em; height: 2.6em; display: grid; place-items: center;\n  border: 2.5px solid currentColor; border-radius: 50%; font-variant-numeric: tabular-nums; }\n.speed .score.good { color: var(--good); } .speed .score.gap { color: var(--leak); } .speed .score.unknown { color: var(--unknown); }\n.speed span { min-width: 0; overflow-wrap: anywhere; font-weight: 600; }\n.speed small { display: block; font-weight: 400; color: var(--muted); font-size: 0.86rem; }\n</style>\n</head>\n<body>\n<header class=\"wrap top\">\n  <a class=\"wm\" href=\"/\" aria-label=\"Ledge Communications\"><span class=\"wm-top\" aria-hidden=\"true\">LEDGE</span><span class=\"wm-sub\" aria-hidden=\"true\">COMMUNICATIONS</span></a>\n  <span class=\"doc-label\">{{doc_label}}</span>\n</header>\n<main class=\"wrap\">\n  <div class=\"strip\" role=\"img\" aria-label=\"Calgary skyline at sunset\"></div>\n  <div class=\"hero\">\n    <p class=\"label\">{{hero_label}}</p>\n    <h1>{{business}}</h1>\n    <p class=\"meta\"><span>{{period}}</span><span>Prepared {{date}}</span></p>\n    <p class=\"lede\">{{summary}}</p>\n  </div>\n\n  <section aria-labelledby=\"numbers-title\">\n    <h2 id=\"numbers-title\">The numbers</h2>\n    <div class=\"tiles\">\n{{{tiles}}}\n    </div>\n    <p class=\"fine under\">A conversion is whatever your account counts as one (a call, a form, a page view). The tracking check below says what yours counts. {{currency_note}}</p>\n  </section>\n\n  <section aria-labelledby=\"value-title\" {{value_hidden}}>\n    <div class=\"value\">\n      <p class=\"label\" id=\"value-title\">What your ads bring in</p>\n      <p class=\"value-big\">{{value_headline}} <small>in work, roughly*</small></p>\n      <p>{{value_line}} {{value_extra}}</p>\n      <p class=\"fine\">* {{value_footnote}}</p>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"wasted-title\" {{wasted_hidden}}>\n    <h2 id=\"wasted-title\">Searches you paid for with no conversions</h2>\n    <p class=\"intro\">{{wasted_line}} Some are worth keeping and some aren't; the checks below say which. The biggest ones:</p>\n    <div class=\"table-wrap\">\n      <table class=\"data\">\n        <thead><tr><th scope=\"col\">What they searched</th><th scope=\"col\">Cost</th><th scope=\"col\">Clicks</th></tr></thead>\n        <tbody>\n{{{wasted_rows}}}\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"checks-title\">\n    <h2 id=\"checks-title\">What we checked</h2>\n    <ol class=\"checks\">\n{{{checks}}}\n    </ol>\n  </section>\n\n  <section aria-labelledby=\"site-title\" {{site_hidden}}>\n    <h2 id=\"site-title\">Your website</h2>\n    <p class=\"site-intro\">{{site_note}}</p>\n    <ul class=\"speed\">\n{{{site_speed}}}\n    </ul>\n    <ol class=\"checks\">\n{{{site_checks}}}\n    </ol>\n    <p class=\"fine under\">Speed scores are Google's PageSpeed test on a phone, out of 100. Scores move a little from one test to the next.</p>\n  </section>\n\n  <section aria-labelledby=\"campaigns-title\" {{campaigns_hidden}}>\n    <h2 id=\"campaigns-title\">Your campaigns</h2>\n    <div class=\"table-wrap\">\n      <table class=\"data campaigns\">\n        <thead><tr><th scope=\"col\">Campaign</th><th scope=\"col\">Cost</th><th scope=\"col\" class=\"clicks\">Clicks</th><th scope=\"col\" class=\"conv\">Conv.</th><th scope=\"col\">Per conv.</th><th scope=\"col\">Missed</th></tr></thead>\n        <tbody>\n{{{campaign_rows}}}\n        </tbody>\n      </table>\n    </div>\n    <p class=\"fine under\">Missed: the share of searches a campaign could have shown on but didn't, because its daily budget ran out.</p>\n  </section>\n\n  <section aria-labelledby=\"moves-title\">\n    <h2 id=\"moves-title\">What I'd change, in order</h2>\n    <ol class=\"moves\">\n{{{actions}}}\n    </ol>\n  </section>\n\n  <section aria-labelledby=\"month-title\" {{first_month_hidden}}>\n    <h2 id=\"month-title\">If we ran it: the first month</h2>\n    <ul class=\"month\">\n{{{first_month}}}\n    </ul>\n  </section>\n\n  <div class=\"ask\" {{ask_hidden}}>\n    <h2>Want us to take it from here?</h2>\n    <p>You can make these changes yourself, or have us do them and keep improving the account month to month. {{ask_line}}</p>\n    <a class=\"btn\" href=\"{{proposal_url}}\">See the plan</a>\n  </div>\n\n  <section aria-labelledby=\"method-title\">\n    <h2 id=\"method-title\">How we did this</h2>\n    <p class=\"fine method\">We read your Google Ads account through our manager account for the dates above, along with the public searches in your free audit. Nothing in your account was changed. You can remove our access at any time under Admin &gt; Access and security &gt; Managers.</p>\n  </section>\n</main>\n<footer class=\"wrap foot\">\n  <p>Prepared by {{sender_name}}, Ledge Communications, Alberta, Canada.</p>\n</footer>\n</body>\n</html>\n";

var MONTHLY_TEMPLATE = "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<title>{{month_name}} report: {{business}}</title>\n<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,900&family=Inter+Tight:wght@700;800&family=Inter:wght@400;500;600;700&display=swap\">\n<style>\n/* Ledge theme: the one place colour and type are set, shared by the site, audit pages, and proposal pages.\n   Current picks: round 3 Amber 2 (royal blue and orange, a quiet vintage Oilers nod), on warm paper with deep navy\n   header and bands; type C (Inter Tight + Inter). Light only: no automatic dark version.\n   --accent is the orange used for buttons; --deep is royal blue for kickers and links; --spruce is the dark bands. */\n:root {\n  --snow: #F8F6F2;\n  --surface: #EFEAE2;\n  --ink: #0F1A2E;\n  --muted: #4D5870;\n  --rule: #E0D9CE;\n  --sky: #2A4FA0;\n  --deep: #2A4FA0;\n  --deep-ink: #FFFFFF;\n  --accent: #F08A24;\n  --accent-ink: #0F1A2E;\n  --accent-text: #A04F0A;\n  --ice: #DDE4F2;\n  --spruce: #0C1630;\n  --head-bg: #0C1630;\n  --head-ink: #FFFFFF;\n  --head-muted: #B9C3D8;\n  --on-dark: #FFFFFF;\n  --on-dark-muted: #B9C3D8;\n  --scrim: rgb(12 22 48 / 0.62);\n  --bad: #B23A26;\n  --good: #2D7A4F;\n  --leak: #A84B0C;\n  --unknown: #5F6B75;\n  --display: \"Inter Tight\", \"Helvetica Neue\", Arial, sans-serif;\n  --display-weight: 800;\n  --display-track: -0.02em;\n  --h3-weight: 700;\n  --body-size: 17px;\n  --body: \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  --mark: \"Archivo\", \"Helvetica Neue\", Arial, sans-serif;\n  color-scheme: light;\n}\n/* Shared layout for audit and proposal pages. Colour and type come from theme.css. */\n*, *::before, *::after { box-sizing: border-box; }\n[hidden] { display: none !important; }\nbody { margin: 0; background: var(--snow); color: var(--ink); font: var(--body-size)/1.6 var(--body); -webkit-font-smoothing: antialiased; }\na { color: inherit; text-underline-offset: 3px; }\nh1, h2, h3 { font-family: var(--display); font-weight: var(--display-weight); margin: 0; line-height: 1.08; text-wrap: balance; letter-spacing: calc(var(--display-track) * 0.8); }\nh3 { font-weight: var(--h3-weight); letter-spacing: -0.01em; }\np { margin: 0; }\n:focus-visible { outline: 3px solid var(--sky); outline-offset: 3px; border-radius: 2px; }\n.wrap { max-width: 820px; margin-inline: auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }\n.top { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 18px; }\n.wm { display: inline-grid; text-decoration: none; line-height: 1; color: var(--ink); }\n.wm-top { font-family: var(--mark); font-weight: 900; font-stretch: 125%; font-size: 1.45rem; letter-spacing: 0.03em; }\n.wm-sub { font-family: var(--body); font-weight: 600; font-size: 0.52rem; letter-spacing: 0.37em; margin-top: 0.35em; color: var(--muted); }\n.doc-label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }\n.strip { height: clamp(120px, 22vw, 200px); background: var(--spruce) center 62% / cover no-repeat; border-radius: 6px; }\n.hero { display: grid; gap: 12px; padding-block: 32px 12px; }\n.label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }\nh1 { font-size: clamp(2.2rem, 6.4vw, 3.2rem); }\n.meta { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.9rem; color: var(--muted); }\n.lede { font-size: 1.12rem; max-width: 40rem; margin-top: 4px; }\nsection { padding-block: 26px; }\nh2 { font-size: 1.7rem; margin-bottom: 14px; }\n.btn { display: inline-flex; align-items: center; justify-content: center; font: 600 1.02rem/1.2 var(--body); text-decoration: none; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 6px; padding: 0.85em 1.3em; cursor: pointer; }\n.btn[disabled] { opacity: 0.6; cursor: progress; }\n.fine { font-size: 0.86rem; color: var(--muted); }\n.foot { padding-block: 24px 40px; border-top: 1px solid var(--rule); font-size: 0.86rem; color: var(--muted); display: grid; gap: 6px; }\n\n/* Layout: the monthly report for a client we run ads for, short enough to read on a phone in a minute. The month's numbers\n   against the month before, roughly what that work is worth, what we changed, the searches that brought calls, what's next. */\n.strip { background-image: url(\"/assets/tower-1200.jpg\"); background-position: 70% 100%; height: clamp(90px, 16vw, 140px); }\n\n.tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }\n@media (max-width: 720px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.tile { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: 14px 16px; display: grid; gap: 2px; align-content: start; min-width: 0; }\n.tile-label { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }\n.tile-value { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.6rem; line-height: 1.15; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }\n.delta { font-size: 0.86rem; font-weight: 600; font-variant-numeric: tabular-nums; }\n.delta.good { color: var(--good); } .delta.gap { color: var(--leak); } .delta.neutral { color: var(--muted); }\n.fine.under { margin-top: 10px; }\n\n.value { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: clamp(18px, 3.5vw, 28px); display: grid; gap: 10px; }\n.value .label { margin: 0; }\n.value-big { font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(1.8rem, 5.5vw, 2.4rem); line-height: 1.05; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }\n.value-big small { font-family: var(--body); font-weight: 500; font-size: 0.95rem; color: var(--muted); letter-spacing: 0; }\n.value p { max-width: 42rem; }\n\n.list { margin: 0; padding-left: 1.2rem; display: grid; gap: 8px; max-width: 42rem; }\n.list li::marker { color: var(--accent-text); }\n\n.table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }\n.data { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 0.95rem; }\n.data th, .data td { text-align: left; padding: 9px 8px; border-bottom: 1px solid var(--rule); vertical-align: baseline; }\n.data thead th { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); border-bottom: 2px solid var(--ink); white-space: nowrap; }\n.data td + td, .data th + th { text-align: right; white-space: nowrap; }\n.data td:first-child { overflow-wrap: anywhere; }\n</style>\n</head>\n<body>\n<header class=\"wrap top\">\n  <a class=\"wm\" href=\"/\" aria-label=\"Ledge Communications\"><span class=\"wm-top\" aria-hidden=\"true\">LEDGE</span><span class=\"wm-sub\" aria-hidden=\"true\">COMMUNICATIONS</span></a>\n  <span class=\"doc-label\">Monthly report</span>\n</header>\n<main class=\"wrap\">\n  <div class=\"strip\" role=\"img\" aria-label=\"Calgary Tower against the sky\"></div>\n  <div class=\"hero\">\n    <p class=\"label\">{{month_name}} for</p>\n    <h1>{{business}}</h1>\n    <p class=\"meta\"><span>Google Ads</span><span>Prepared {{date}}</span></p>\n    <p class=\"lede\">{{headline}}</p>\n    <p>{{summary}}</p>\n  </div>\n\n  <section aria-labelledby=\"numbers-title\">\n    <h2 id=\"numbers-title\">The month</h2>\n    <div class=\"tiles\">\n{{{tiles}}}\n    </div>\n    <p class=\"fine under\">Calls and forms are the ones your account recorded from your ads. {{compare_note}}</p>\n  </section>\n\n  <section aria-labelledby=\"value-title\" {{value_hidden}}>\n    <div class=\"value\">\n      <p class=\"label\" id=\"value-title\">What that's worth</p>\n      <p class=\"value-big\">{{value_headline}} <small>in work, roughly*</small></p>\n      <p>{{value_line}}</p>\n      <p class=\"fine\">* {{value_footnote}}</p>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"changes-title\">\n    <h2 id=\"changes-title\">What we changed</h2>\n    <ul class=\"list\">\n{{{changes}}}\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"searches-title\" {{searches_hidden}}>\n    <h2 id=\"searches-title\">Searches that brought calls and forms</h2>\n    <div class=\"table-wrap\">\n      <table class=\"data\">\n        <thead><tr><th scope=\"col\">What they searched</th><th scope=\"col\">Calls and forms</th><th scope=\"col\">Cost</th></tr></thead>\n        <tbody>\n{{{searches}}}\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"next-title\">\n    <h2 id=\"next-title\">What's next</h2>\n    <ul class=\"list\">\n{{{next}}}\n    </ul>\n    <p class=\"fine under\">Questions or something you'd like done differently? Reply to the email this came in.</p>\n  </section>\n</main>\n<footer class=\"wrap foot\">\n  <p>Prepared by {{sender_name}}, Ledge Communications, Alberta, Canada.</p>\n</footer>\n</body>\n</html>\n";

var PROMPT_AUDIT = "You build Local Search Audits for Ledge Communications, a small Alberta business run by Logan. Ledge helps local service businesses get found and chosen on Google: Google Ads, Local Services Ads, the Google Business Profile that drives the map, and the page an ad click lands on. Most clients are owner-run trades shops (heating and cooling, plumbing, electrical, roofing, garage doors, appliance repair), but the same work fits any local business people search for on their phone.\n\nAn audit is a one-page look at one business from the outside. The owner reads it on their phone. It has to be accurate, specific, and worth reading even if they never hire Ledge. It should also make plain, without selling, what it would take to show up where their customers are looking.\n\n# Google's names\nLocal Services Ads are the pay-per-lead listings at the very top of many local searches. In late 2025 Google replaced their \"Google Guaranteed\", \"Google Screened\", and \"License verified\" badges with one \"Google Verified\" badge and ended the money-back guarantee. Call them Local Services Ads (the first time: \"the Google Verified listings at the very top\"). Never write \"Google Guaranteed\" or promise any guarantee; say \"Google Verified\" only for the badge.\n\n# What you're given\nThe request ends with EVIDENCE gathered by our tools today:\n- Two Google searches a customer would run, done as a phone located in the shop's town. For each: the Local Services Ads (Google Verified listings), the sponsored results, the map pack, and the websites, top of the page down, with the shop marked [THIS SHOP] wherever it showed up. Plus where the shop sits in Google Maps for the same search.\n- Google's monthly search estimates for those searches and two related ones, and the wider market: all the related searches about this work in the town, with the total. The total is the better number for the size of the opportunity. A single small figure for a \"near me\" search undersells it.\n- A VALUE ESTIMATE worked out by our tools: what those searches are worth in booked work at typical rates and typical local prices, plus what one big job is worth. The page shows it near the top with a footnote explaining how it was worked out.\n- The shop's Google Search ads in Google's Ads Transparency Center over the last 30 days. This sets the segment: `running_ads`, `no_ads`, or `unknown`.\n- A scan of the home page code: Google Ads tag, Google Analytics, Tag Manager, call tracking, tap-to-call links, forms, and online booking.\n- The shop's Google Business Profile, when we found it in Maps: rating and review count, main and other categories, whether the owner has claimed it, how many photos it has (and how many the top shops on these searches have), its hours, and whether it lists a phone number, website, and booking link.\n\nThe audit page shows the searches itself, as a table, so don't restate every row. Use them for findings.\n\n# Rules that never bend\n- Public information only. You read pages; you never contact the business, click an ad, submit a form, or pretend to be a customer.\n- Every finding is something in the evidence or something you saw yourself on a page you fetched or a search result you read today. Link pages you used in `sources`.\n- No invented numbers. Use only counts, ranks, ratings, and search estimates from the evidence or a page you read. Round search estimates the way they're given (\"about 170 searches a month\").\n- Money comes only from the VALUE ESTIMATE, word for word, and always as an estimate (\"roughly\", \"at typical rates\"). Never say they're losing it, never promise it, and never add other dollar figures, click prices, statistics, or percentages. With no VALUE ESTIMATE, give no dollar figures.\n- Never guess what a shop spends on ads.\n- A search is a snapshot. Say \"when we searched\" or \"on this search\", never \"you never show up\".\n- A shop missing from one search's ads isn't proof it doesn't advertise. The Transparency Center record decides that.\n- No Google Ads tag on the home page doesn't mean there's no tracking when Google Tag Manager is installed. Say it may be inside Tag Manager and mark that check `unknown`.\n- Only suggest Local Services Ads when they showed on at least one of the searches.\n- If the evidence is mostly missing (the searches didn't run) and you can't find at least three real findings yourself, set `\"build\": false` and give the reason. A thin audit does more harm than none.\n\n# How to research (a few fetches, at most a couple of searches)\n1. Fetch the home page and the contact page. Look at what a phone visitor sees first: the phone number, tap-to-call, a form, online booking, and what the page says the business does.\n2. If the evidence has no rating for the shop, search once for its Google reviews.\n3. Fetch other pages only when a finding depends on it (for example a service page for the main search).\n\n# The six checks, always in this order\n1. Map results: where the shop sits on the map and in Google Maps for each search, and the most likely reason when it's low (main category, missing categories, few reviews or photos next to the shops above, an unclaimed profile, hours that don't cover when people search, a different town in the profile). Only name a reason you can see in the evidence. An unclaimed profile is always worth saying.\n2. Local Services Ads: who shows in the Google Verified listings and whether the shop does.\n3. Search ads: what the Transparency Center shows for the shop, whether its ads appeared on the searches, and who advertises on them.\n4. Reviews: rating, count, and how they compare with the shops above them on the map, using the evidence numbers.\n5. Call and form tracking: what the home page scan shows (Google Ads tag, Analytics, Tag Manager, call tracking). For a shop not running ads, say what would need to be in place before ad money is spent.\n6. Where clicks land: what a phone visitor sees on the page ads and searches lead to: tap-to-call near the top, a short form, online booking, emergency or after-hours service if the business offers it.\n\nEach check gets `status` (`good`, `gap`, or `unknown`; `gap` shows on the page as \"Needs work\") and a `note`: one or two short sentences naming the actual search, rank, number, or button.\n\n# The three moves\nThree moves, ranked by what would most likely bring the shop more calls and booked jobs from Google right now, given the season. Each has an `offer`, which shows on the page as a small tag:\n- `setup`: Ledge sets up Google Ads, Local Services Ads, or call tracking for a shop that isn't running ads. Use only when the segment is `no_ads` or `unknown`.\n- `paid_audit`: the paid Google Ads audit, where Ledge looks inside the account. Call it \"the Google Ads audit\" in anything the owner reads. Use only when the segment is `running_ads` or `unknown`.\n- `management`: Ledge runs and improves ads month to month. Use only when the segment is `running_ads` or `unknown`.\n- `page_fixes`: a one-time add-on where Ledge changes their current website so more clicks turn into calls: a tap-to-call button near the top, a shorter form, a booking button, call tracking. Any segment. Ledge makes the changes, or guides whoever runs their site through them; the tag on the page says so.\n- `landing_page`: a one-time add-on where Ledge builds one page for their ads, when the site has no page about the service they'd advertise, or it's too slow or broken to send ad clicks to. Use it rarely; prefer `page_fixes`.\n- `free`: a quick win that takes a few minutes, like a Google Business Profile change. The page tags it as included in any Ledge plan, and `effort` says what it takes. At most one, and it goes last unless it's clearly the most urgent (for example the site is down or has no phone number).\n\nAt most one page move (`page_fixes` or `landing_page`) per audit. A page move is the right call when \"Where clicks land\" needs work, because search ads or Local Services Ads would send people there.\n\nFor a `running_ads` shop the first move is usually `paid_audit`: name the specific thing from the evidence that the Google Ads audit would explain (ads missing from their main search, no call tracking, clicks landing on a page with no tap-to-call). When \"Where clicks land\" needs work too, the page offers the account and site audit together, so the `why` can say the audit would cover the page as well. For a `no_ads` shop the first move is usually `setup`: point at who is advertising or in Local Services Ads on their searches, and what the searches are worth from the VALUE ESTIMATE.\n\n- `title`: an instruction, under 12 words.\n- `why`: one or two sentences tied to the evidence.\n- `effort`: only for a `free` move, in plain words (for example \"About five minutes in your Google Business Profile\"). Leave it empty for the others; the page shows their price.\n\nAnything worth fixing that isn't one of these moves (a slow or broken website, a site rebuild, a missing service page, social media) goes in `later` as one plain sentence, at most two items, or leave `later` empty. Never price or promise those.\n\n# What the owner told us\nIf the request includes what the owner said on the form, use it. It can settle a check you couldn't see from outside; say \"You told us...\" in that note. Never let it override something you saw yourself.\n\n# Voice\nLedge should read as reliable, honest, knowledgeable, and human. Never salesy, pushy, jargony, or trendy.\n- Write the way Logan would explain it across a counter: plain words, short sentences, friendly, straight to the point.\n- Say \"you\" and \"your shop\" (or \"your clinic\", \"your business\", whatever fits). Name the real search, rank, page, or number.\n- Say \"Local Services Ads\", \"search ads\" or \"the ads\", \"the map\", \"Google Maps\". Avoid jargon like CPC, CTR, ROAS, SERP, LSA, conversion rate, funnel, or impressions.\n- No hype words (game-changer, seamless, unlock, leverage, robust, streamline, supercharge, elevate, dominate).\n- No em dashes. No \"not X, but Y\". No rhetorical questions. No exclamation marks.\n- Use the Oxford comma in any list of three or more (\"calls, forms, and quotes\").\n- Don't use the words \"leak\", \"leaky\", or \"slip\". Say plainly what's missing, slow, or hard to find.\n- Give credit where it's due. If something is good, say so.\n- `summary`: two sentences at most. The first says what a customer sees when they search; the second names the biggest opportunity, tied to the VALUE ESTIMATE's yearly figure when there is one (for example: \"Those searches are worth roughly $7,200 to $12,000 a year in work, and right now three other shops get them.\").\n- `top_finding`: one sentence, under 25 words, the biggest finding in plain words. It goes into an email, next to a line with the yearly estimate, so don't repeat the dollar figure here.\n- `fix_1`: the first move as a lowercase phrase that completes \"I'd start here: ...\".\n\n# Contact details (only when the request says Purpose: cold)\nLedge may email this business, so Canada's anti-spam law applies. Find an email address the business itself published on its own website or its own Google listing.\n- Never guess an address and never take one from a directory, data broker, or third-party listing site.\n- If the page near the address says it doesn't want solicitations or marketing email, set `no_solicitation_notice` to true.\n- `proof_url` is the page where you saw the address and `proof_excerpt` is about 100 characters of the text around it, copied exactly.\n- Use the owner's first name only if the site names them. Otherwise leave it empty.\n- If there is no qualifying address, set `email` to null. The audit can still be built.\n\n# Output\nReply with one JSON object inside a single ```json code block and nothing after it:\n\n```json\n{\n  \"build\": true,\n  \"skip_reason\": \"\",\n  \"business\": \"Business name as the business writes it\",\n  \"area\": \"Airdrie\",\n  \"summary\": \"...\",\n  \"checks\": [\n    {\"status\": \"gap\", \"note\": \"...\"},\n    {\"status\": \"gap\", \"note\": \"...\"},\n    {\"status\": \"gap\", \"note\": \"...\"},\n    {\"status\": \"good\", \"note\": \"...\"},\n    {\"status\": \"unknown\", \"note\": \"...\"},\n    {\"status\": \"gap\", \"note\": \"...\"}\n  ],\n  \"moves\": [\n    {\"title\": \"...\", \"why\": \"...\", \"offer\": \"setup\", \"effort\": \"\"},\n    {\"title\": \"...\", \"why\": \"...\", \"offer\": \"setup\", \"effort\": \"\"},\n    {\"title\": \"...\", \"why\": \"...\", \"offer\": \"free\", \"effort\": \"...\"}\n  ],\n  \"later\": [\"...\"],\n  \"sources\": [\n    {\"label\": \"Home page\", \"url\": \"https://...\"},\n    {\"label\": \"Contact page\", \"url\": \"https://...\"}\n  ],\n  \"top_finding\": \"...\",\n  \"fix_1\": \"...\",\n  \"contact\": {\n    \"email\": null,\n    \"first_name\": \"\",\n    \"contact_name\": \"\",\n    \"phone\": \"\",\n    \"proof_url\": \"\",\n    \"proof_excerpt\": \"\",\n    \"no_solicitation_notice\": false\n  }\n}\n```\n";

