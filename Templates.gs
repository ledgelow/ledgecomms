n    <form id=\"quote-form\" class=\"ask-form\" method=\"post\" action=\"/api/quote-request\">\n      <p>I can set these up for you for a fixed price. Tap below and I'll email the price and what's included by end of day tomorrow. No call needed.</p>\n      <input type=\"hidden\" name=\"id\" value=\"{{lead_id}}\">\n      <input type=\"hidden\" name=\"t\" value=\"{{token}}\">\n      <label for=\"q-notes\">Anything I should know? <span style=\"font-weight:400;opacity:.8\">(optional)</span></label>\n      <textarea id=\"q-notes\" name=\"notes\" placeholder=\"For example: we use Jobber, or we're mostly booked out until March.\"></textarea>\n      <p class=\"err\" id=\"q-err\" role=\"alert\" hidden></p>\n      <div class=\"row\">\n        <button class=\"btn\" id=\"q-btn\" type=\"submit\">Send me a fixed price</button>\n        <span class=\"alt\" data-booking-wrap>Rather talk it through? <a data-booking href=\"#\">Book 15 minutes</a></span>\n      </div>\n    </form>\n    <div id=\"q-done\" hidden>\n      <p><strong>Got it.</strong> The price and what's included will be in your inbox by end of day tomorrow.</p>\n    </div>\n  </div>\n\n  <section aria-labelledby=\"sources-title\">\n    <h2 id=\"sources-title\">What I looked at</h2>\n    <ul class=\"sources\">\n{{{sources}}}\n    </ul>\n  </section>\n</main>\n<footer class=\"wrap foot\">\n  <p>Prepared by {{sender_name}}, Ledge Communications, Calgary, Alberta.</p>\n  <p>This audit uses public information only. Nobody called your business or filled in your forms.</p>\n</footer>\n<script>\n(function () {\n  var form = document.getElementById('quote-form');\n  if (!form) return;\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    var btn = document.getElementById('q-btn'), err = document.getElementById('q-err');\n    btn.disabled = true; btn.textContent = 'Sending…'; err.hidden = true;\n    fetch('/api/quote-request', { method: 'POST', body: new FormData(form), headers: { 'accept': 'application/j