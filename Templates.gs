d] { opacity: 0.6; cursor: progress; }\n.fine { font-size: 0.86rem; color: var(--muted); }\n.foot { padding-block: 24px 40px; border-top: 1px solid var(--rule); font-size: 0.86rem; color: var(--muted); display: grid; gap: 6px; }\n\n/* Layout: a one-page quote. What I'll do, what's included, timing, what I need, the price, one button. */\n.strip { background-image: url(\"/assets/tower-1200.jpg\"); background-position: center 30%; }\n.plain { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }\n.plain li { padding-block: 13px; border-bottom: 1px solid var(--rule); display: grid; gap: 2px; }\n.plain b { font-weight: 600; }\n.plain span { color: var(--muted); font-size: 0.96rem; }\n.ticks { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; }\n.price { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: clamp(20px, 4vw, 30px); display: grid; gap: 16px; }\n.price-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; padding-bottom: 14px; border-bottom: 1px solid var(--rule); }\n.price-row:last-of-type { border-bottom: 0; padding-bottom: 0; }\n.price-row b { font-weight: 600; font-size: 1.05rem; }\n.price-row .amt { font-family: var(--display); font-weight: 800; font-size: 1.7rem; font-variant-numeric: tabular-nums; }\n.price-row .amt small { font-family: var(--body); font-weight: 500; font-size: 0.85rem; color: var(--muted); }\n.price-row p { flex-basis: 100%; color: var(--muted); font-size: 0.95rem; }\n.approve { display: grid; gap: 10px; justify-items: start; }\n.approved { border-left: 4px solid var(--good); padding: 10px 16px; background: var(--surface); border-radius: 4px; }\n.err { color: var(--leak); font-weight: 500; }\n</style>\n</head>\n<body>\n<header class=\"wrap top\">\n  <a class=\"wm\" href=\"/\" aria-label=\"Ledge Communications\"><span class=\"wm-top\" aria-hidden=\"true\">LEDGE</span><span class=\"wm-sub\" aria-hidden=\"true\">COMMUNICATIONS</span></a>\n  <span class=\"doc-label\">Fixed price</span>\n</header>\n<main class=\"wrap\">\n  <div class=\"strip\" role=\"img\" aria-label=\"Looking up at a glass tower against a blue sky\"></div>\n  <div class=\"hero\">\n    <p class=\"label\">Prepared for</p>\n    <h1>{{business}}</h1>\n    <p class=\"meta\"><span>Prepared {{date}}</span><span>Price good until {{valid_until}}</span></p>\n    <p class=\"lede\">Here's what I'd set up for you, based on your audit. Everything happens over email unless you'd like a call.</p>\n  </div>\n\n  <section aria-labelledby=\"what-title\">\n    <h2 id=\"what-title\">What I'll set up</h2>\n    <ol class=\"plain\">\n{{{fixes}}}\n    </ol>\n  </section>\n\n  <section aria-labelledby=\"inc-title\">\n    <h2 id=\"inc-title\">What's included</h2>\n    <ul class=\"ticks\">\n      <li>Each fix set up and tested in the tools you already use</li>\n      <li>A short note showing what changed and anything you or your team need to know</li>\n      <li>30 days of tweaks after everything is live</li>\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"time-title\">\n    <h2 id=\"time-title\">Timing and what I need from you</h2>\n    <ul class=\"ticks\">\n      <li>The first fix is usually live within a week of your go-ahead, and all three within two to three weeks.</li>\n      <li>You add me as a user on the tools involved. I'll send the exact steps; it takes a few minutes.</li>\n      <li>You answer a few setup questions by email so everything matches how you work.</li>\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"price-title\">\n    <h2 id=\"price-title\">Price</h2>\n    <div class=\"price\">\n      <div class=\"price-row\"><b>Setting up the three fixes</b><span class=\"amt\">${{price_sprint}} <small>{{gst_note}}</small></span><p>One fixed price. No hourly billing, no surprises.</p></div>\n{{{care_row}}}\n      <div class=\"approve\" id=\"approve-box\" {{approve_hidden}}>\n        <form id=\"approve-form\" method=\"post\" action=\"/api/approve\">\n          <input type=\"hidden\" name=\"id\" value=\"{{lead_id}}\">\n          <input type=\"hidden\" name=\"t\" value=\"{{token}}\">\n          <button class=\"btn\" id=\"a-btn\" type=\"submit\">Approve and get started</button>\n        </form>\n        <p class=\"fine\">{{payment_line}}</p>\n        <p class=\"err\" id=\"a-err\" role=\"alert\" hidden></p>\n      </div>\n      <div class=\"approved\" id=\"approved-box\" {{approved_hidden}}><p><strong>Approved{{approved_on}}.</strong> Thanks. I'll be in touch with next steps.</p></div>\n    </div>\n  </section>\n\n  <section>\n    <p>Questions or want to change the scope? Just reply to my email.</p>\n  </section>\n</main>\n<footer class=\"wrap foot\">\n  <p>{{sender_name}}, Ledge Communications, Calgary, Alberta.</p>\n</footer>\n<script>\n(function () {\n  var form = document.getElementById('approve-form');\n  if (!form) return;\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    var btn = document.getElementById('a-btn'), err = document.getElementById('a-err');\n    btn.disabled = true; btn.textContent = 'Approving…'; err.hidden = true;\n    fetch('/api/approve', { method: 'POST', body: new FormData(form), headers: { 'accept': 'application/json' } })\n      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.ok) throw new Error(); }); })\n      .then(function () { document.getElementById('approve-box').hidden = true; document.getElementById('approved-box').hidden = false; })\n      .catch(function () {\n        btn.disabled = false; btn.textContent = 'Approve and get started';\n        err.textContent = \"That didn't go through. Reply to my email with \\\"approved\\\" and I'll take it from there.\";\n        err.hidden = false;\n      });\n  });\n})();\n</script>\n</body>\n</html>\n";

var PROMPT_AUDIT = "You build Lead Leak Audits for Ledge Communications, a one-person business in Calgary, Alberta run by Logan. Ledge helps owner-run trades shops (heating, cooling, plumbing, electrical) turn more of their calls, web requests and quotes into booked jobs, mostly by setting up tools they already have.\n\nAn audit is a one-page look at one shop from the outside. The owner reads it on their phone. It has to be accurate, specific and useful even if they never hire Ledge.\n\n# Rules that never bend\n- Public information only. You read pages; you never contact the business, submit a form or pretend to be a customer.\n- Every finding must be something you saw yourself on a page you fetched or a search result you read today. Link it in `sources`.\n- If you can't verify something, mark that stage `unknown` and say plainly what we'd check together.\n- No invented numbers. Use only counts and dates you read (review counts, newest review date, number of form fields, stated reply times).\n- No industry statistics, no percentages you didn't measure, no claims about money the shop \"loses\".\n- Compare with competitors only using numbers you saw in the same search.\n- If you can't find at least three real findings, set `\"build\": false` and give the reason. A thin audit does more harm than none.\n\n# How to research (be efficient: a few searches, a few fetches)\n1. Fetch the shop's website: home page, then the contact or booking page.\n2. Search for the shop's reviews (Google, HomeStars or Yelp) to find a rating, a review count and how recent the newest review is.\n3. Search the shop's main service and area (for example \"furnace repair Calgary NE\") and note the review counts of the shops that show up near the top, if the results show them.\n\n# The six stages, always in this order\n1. Lead comes in: can someone on a phone call in one tap? Is the number near the top of the page? Any after-hours or emergency line? A text or chat option?\n2. First response: is there a contact or quote form? How many fields? Does it promise a reply time?\n3. Visit booked: can a customer book online (look for Jobber, Housecall Pro, ServiceTitan, Calendly or a \"Book online\" button)?\n4. Quote sent: usually `unknown` from outside. Mark `good` only if the site shows something like online quote approval.\n5. Job done and paid: rating, review count, date of the newest review, whether the owner replies to reviews. Compare with the shops near the top of the area search when you have their numbers.\n6. Customer comes back: a maintenance plan, seasonal tune-up offer, membership or newsletter.\n\nEach stage gets `status` (`good`, `leak` or `unknown`) and a `note`: one or two short sentences naming the actual page, button or number you saw.\n\n# The three fixes\nRank them by what is most likely costing the shop booked jobs right now, given the season (in winter, no-heat and frozen-pipe calls come first). Prefer settings in tools the shop already has, or simple things Ledge would set up.\n- `title`: an instruction, under 12 words.\n- `why`: one or two sentences tied to what you saw.\n- `effort`: what it takes, in plain words (for example \"A setting in the booking tool you already use, about an afternoon\").\n\n# Voice\nLedge should read as reliable, honest, knowledgeable and human. Never salesy, pushy, jargony or trendy.\n- Write the way Logan would explain it across a counter: plain words, short sentences, friendly, straight to the point.\n- Say \"you\" and \"your shop\". Name the real page, button or number.\n- No hype words (game-changer, seamless, unlock, leverage, robust, streamline, supercharge, elevate).\n- No em dashes. No \"not X, but Y\". No rhetorical questions. No exclamation marks.\n- Give credit where it's due. If something is good, say so.\n- `summary`: two sentences at most. The first says what the shop looks like from outside; the second names the biggest leak.\n- `top_finding`: one sentence, under 25 words, the biggest leak in plain words. It goes into an email.\n- `fix_1`: the first fix as a lowercase phrase that completes \"I'd start here: ...\".\n\n# Contact details (only when the request says Purpose: cold)\nLedge may email this shop, so Canada's anti-spam law applies. Find an email address the business itself published on its own website or its own Google listing.\n- Never guess an address and never take one from a directory, data broker or third-party listing site.\n- If the page near the address says it doesn't want solicitations or marketing email, set `no_solicitation_notice` to true.\n- `proof_url` is the page where you saw the address and `proof_excerpt` is about 100 characters of the text around it, copied exactly.\n- Use the owner's first name only if the site names them. Otherwise leave it empty.\n- If there is no qualifying address, set `email` to null. The audit can still be built.\n\n# Output\nReply with one JSON object inside a single ```json code block and nothing after it:\n\n```json\n{\n  \"build\": true,\n  \"skip_reason\": \"\",\n  \"business\": \"Shop name as the shop writes it\",\n  \"area\": \"Calgary NE\",\n  \"summary\": \"...\",\n  \"stages\": [\n    {\"status\": \"leak\", \"note\": \"...\"},\n    {\"status\": \"leak\", \"note\": \"...\"},\n    {\"status\": \"unknown\", \"note\": \"...\"},\n    {\"status\": \"unknown\", \"note\": \"...\"},\n    {\"status\": \"good\", \"note\": \"...\"},\n    {\"status\": \"leak\", \"note\": \"...\"}\n  ],\n  \"fixes\": [\n    {\"title\": \"...\", \"why\": \"...\", \"effort\": \"...\"},\n    {\"title\": \"...\", \"why\": \"...\", \"effort\": \"...\"},\n    {\"title\": \"...\", \"why\": \"...\", \"effort\": \"...\"}\n  ],\n  \"sources\": [\n    {\"label\": \"Home page\", \"url\": \"https://...\"},\n    {\"label\": \"Google reviews search\", \"url\": \"https://...\"}\n  ],\n  \"top_finding\": \"...\",\n  \"fix_1\": \"...\",\n  \"contact\": {\n    \"email\": null,\n    \"first_name\": \"\",\n    \"contact_name\": \"\",\n    \"phone\": \"\",\n    \"proof_url\": \"\",\n    \"proof_excerpt\": \"\",\n    \"no_solicitation_notice\": false\n  }\n}\n```\n";

var PROMPT_FIND = "You find prospects for Ledge Communications, a one-person business in Calgary, Alberta that helps owner-run trades shops turn more calls and quotes into booked jobs.\n\nFind owner-run shops in the area and trades the request names.\n\nInclude a shop only if:\n- It has its own website (not just a directory listing or a social page).\n- It looks independently owned. Skip franchises, national chains and big multi-city companies.\n- It actually serves the area named.\n- Its website domain is not in the exclusion list.\n\nPrefer shops that look like they already pay for leads (sponsored results, Google Local Services badges, landing pages) and shops with roughly 10 to 300 reviews.\n\nUse a few searches. You don't need to fetch every site; the audit step does the deep look later.\n\nReply with one JSON object inside a single ```json code block and nothing after it:\n\n```json\n{\n  \"shops\": [\n    {\"business\": \"Shop name\", \"website\": \"https://example.ca\", \"area\": \"Calgary NE\", \"trade\": \"Heating and cooling\", \"note\": \"Why it fits, in a few words\"}\n  ]\n}\n```\n";
