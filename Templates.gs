tion { padding-block: 26px; }\nh2 { font-size: 1.7rem; margin-bottom: 14px; }\n.btn { display: inline-flex; align-items: center; justify-content: center; font: 600 1.02rem/1.2 var(--body); text-decoration: none; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 6px; padding: 0.85em 1.3em; cursor: pointer; }\n.btn[disabled] { opacity: 0.6; cursor: progress; }\n.fine { font-size: 0.86rem; color: var(--muted); }\n.foot { padding-block: 24px 40px; border-top: 1px solid var(--rule); font-size: 0.86rem; color: var(--muted); display: grid; gap: 6px; }\n\n/* Layout: a one-page offer. What we'll do, what you get, what's not included, timing, the price (with the fee table\n   for monthly work), one button. */\n.strip { background-image: url(\"/assets/tower-1200.jpg\"); background-position: 70% 100%; }\n.plain { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }\n.plain li { padding-block: 13px; border-bottom: 1px solid var(--rule); display: grid; gap: 2px; }\n.plain b { font-weight: 600; }\n.plain span { color: var(--muted); font-size: 0.96rem; }\n.ticks { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; }\n.price { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: clamp(20px, 4vw, 30px); display: grid; gap: 16px; }\n.price-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; padding-bottom: 14px; border-bottom: 1px solid var(--rule); }\n.price-row b { font-weight: 600; font-size: 1.05rem; }\n.price-row .amt { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.7rem; font-variant-numeric: tabular-nums; }\n.price-row .amt small { font-family: var(--body); font-weight: 500; font-size: 0.85rem; color: var(--muted); }\n.price-row.quiet .amt { font-size: 1.3rem; color: var(--muted); }\n.price-row.credit .amt { font-size: 1.3rem; color: var(--good); }\n.price-row p { flex-basis: 100%; color: var(--muted); font-size: 0.95rem; }\n.tiers { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 0.97rem; }\n.tiers caption { text-align: left; font-weight: 600; padding-bottom: 8px; }\n.tiers th, .tiers td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--rule); }\n.tiers th { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }\n.tiers td:last-child, .tiers th:last-child { text-align: right; }\n.tiers tr.yours td { background: var(--ice); font-weight: 600; }\n.tiers-note { color: var(--muted); font-size: 0.92rem; margin-top: 8px; }\n.approve { display: grid; gap: 10px; justify-items: start; }\n.approve form { display: grid; gap: 14px; justify-items: start; }\n.addons { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; min-width: 0; }\n.addons legend { font-weight: 600; padding: 0; margin-bottom: 4px; }\n.addons legend span { font-weight: 400; color: var(--muted); }\n.addons label { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px; align-items: start; background: var(--snow); border: 1.5px solid var(--rule); border-radius: 6px; padding: 12px 14px; cursor: pointer; color: var(--muted); font-size: 0.95rem; }\n.addons label b { color: var(--ink); font-weight: 600; display: block; }\n.addons input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--deep); }\n.addons label:has(input:checked) { border-color: var(--deep); }\n.approved { border-left: 4px solid var(--good); padding: 10px 16px; background: var(--snow); border-radius: 4px; }\n.err { color: var(--leak); font-weight: 500; }\n.plain-list { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; color: var(--muted); }\n.plain-list + .fine { margin-top: 12px; }\n</style>\n</head>\n<body>\n<header class=\"wrap top\">\n  <a class=\"wm\" href=\"/\" aria-label=\"Ledge Communications\"><span class=\"wm-top\" aria-hidden=\"true\">LEDGE</span><span class=\"wm-sub\" aria-hidden=\"true\">COMMUNICATIONS</span></a>\n  <span class=\"doc-label\">{{doc_label}}</span>\n</header>\n<main class=\"wrap\">\n  <div class=\"strip\" role=\"img\" aria-label=\"Looking up at a glass tower against a blue sky\"></div>\n  <div class=\"hero\">\n    <p class=\"label\">Prepared for</p>\n    <h1>{{business}}</h1>\n    <p class=\"meta\"><span>Prepared {{date}}</span><span>Price good until {{valid_until}}</span></p>\n    <p class=\"lede\">{{lede}}</p>\n  </div>\n\n  <section aria-labelledby=\"what-title\">\n    <h2 id=\"what-title\">{{scope_title}}</h2>\n    <ol class=\"plain\">\n{{{scope}}}\n    </ol>\n  </section>\n\n  <section aria-labelledby=\"inc-title\">\n    <h2 id=\"inc-title\">What you get</h2>\n    <ul class=\"ticks\">\n{{{included}}}\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"out-title\">\n    <h2 id=\"out-title\">Not included</h2>\n    <ul class=\"plain-list\">\n{{{excluded}}}\n    </ul>\n    <p class=\"fine\">If something turns out bigger once we're in, you'll hear about it before any extra work, and you can say no.</p>\n  </section>\n\n  <section aria-labelledby=\"time-title\">\n    <h2 id=\"time-title\">Timing and what we need from you</h2>\n    <ul class=\"ticks\">\n{{{timing}}}\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"price-title\">\n    <h2 id=\"price-title\">Price</h2>\n    <div class=\"price\">\n{{{price_rows}}}\n      <div {{tiers_hidden}}>\n        <table class=\"tiers\">\n          <caption>How the monthly fee is set</caption>\n          <thead><tr><th scope=\"col\">Your monthly ad budget</th><th scope=\"col\">Our monthly fee</th></tr></thead>\n          <tbody>\n{{{tiers}}}\n          </tbody>\n        </table>\n        <p class=\"tiers-note\">{{tiers_note}}</p>\n      </div>\n      <div class=\"approve\" id=\"approve-box\" {{approve_hidden}}>\n        <form id=\"approve-form\" method=\"post\" action=\"/api/approve\">\n          <input type=\"hidden\" name=\"id\" value=\"{{lead_id}}\">\n          <input type=\"hidden\" name=\"t\" value=\"{{token}}\">\n{{{addons}}}\n          <button class=\"btn\" id=\"a-btn\" type=\"submit\">{{approve_label}}</button>\n        </form>\n        <p class=\"fine\">{{payment_line}}</p>\n        <p class=\"err\" id=\"a-err\" role=\"alert\" hidden></p>\n      </div>\n      <div class=\"approved\" id=\"approved-box\" {{approved_hidden}}><p><strong>Approved{{approved_on}}.</strong> Thanks. Next steps are on their way to your inbox.</p></div>\n    </div>\n  </section>\n\n  <section>\n    <p>Questions, or want to change the budget or the scope? Just reply to the email.</p>\n  </section>\n</main>\n<footer class=\"wrap foot\">\n  <p>{{sender_name}}, Ledge Communications, Alberta, Canada.</p>\n</footer>\n<script>\n(function () {\n  var form = document.getElementById('approve-form');\n  if (!form) return;\n  var label = document.getElementById('a-btn').textContent;\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    var btn = document.getElementById('a-btn'), err = document.getElementById('a-err');\n    btn.disabled = true; btn.textContent = 'Approving…'; err.hidden = true;\n    fetch('/api/approve', { method: 'POST', body: new FormData(form), headers: { 'accept': 'application/json' } })\n      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok || !j.ok) throw new Error(); }); })\n      .then(function () { document.getElementById('approve-box').hidden = true; document.getElementById('approved-box').hidden = false; })\n      .catch(function () {\n        btn.disabled = false; btn.textContent = label;\n        err.textContent = \"That didn't go through. Reply to the email with \\\"approved\\\" and we'll take it from there.\";\n        err.hidden = false;\n      });\n  });\n})();\n</script>\n</body>\n</html>\n";

