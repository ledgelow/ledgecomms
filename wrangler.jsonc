// Cloudflare Workers config for ledgecommunications.com.
// Cloudflare reads this on every deploy. The name must match the Worker's name in the dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledgecomms",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  // Arranges the flat repo into site/ before each deploy.
  "build": { "command": "node build-site.js" },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Keep the variables set in the dashboard when a new version deploys from GitHub.
  "keep_vars": true,
  "observability": { "enabled": true }
}
